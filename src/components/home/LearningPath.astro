---
/**
 * Схема пути обучения: главы курса (= главы «Искусства схемотехники») и дополнительные модули.
 * На узком экране карточки идут в столбик.
 */
import { withBase } from '../../lib/site';

const stages = [
	{ n: '1', t: 'Основы электроники', d: 'Ом, Кирхгоф, R, C, L, импеданс, диоды', href: 'm01-basics/01-current-voltage/' },
	{ n: '2', t: 'Транзисторы', d: 'Ключ, повторитель, усилитель, каскады', href: 'm02-transistors/00-intro/' },
	{ n: '3', t: 'Полевые транзисторы', d: 'Характеристики, источники тока, ключи', href: 'm03-fet/00-intro/' },
	{ n: '4', t: 'Обратная связь и ОУ', d: 'От золотых правил до коррекции', href: 'm04-opamps/00-intro/' },
	{ n: '5', t: 'Фильтры и генераторы', d: 'Саллен — Ки, 555, мост Вина, кварц', href: 'm05-filters-oscillators/01-active-filters/' },
	{ n: '6', t: 'Источники питания', d: '723, теплоотвод, выпрямители, DC-DC', href: 'm06-power/01-regulator-723/' },
];
const extra = [
	{ n: '7', t: 'Практикум', d: 'схемы, корпуса, даташиты, макетка', href: 'm07-practice/01-reading-schematics/' },
	{ n: '8–10', t: 'Печатные платы', d: 'устройство, проектирование, производство', href: 'm08-pcb-basics/01-from-wires-to-pcb/' },
	{ n: '11', t: 'ВЧ- и СВЧ-платы', d: 'линии 50 Ом, согласование, антенны', href: 'm11-rf/01-when-rf/' },
];
---

<ol class="path not-content" aria-label="Главы курса">
	{
		stages.map((s) => (
			<li class="stage">
				<a href={withBase(s.href)}>
					<span class="stage__n">Глава {s.n}</span>
					<span class="stage__t">{s.t}</span>
					<span class="stage__d">{s.d}</span>
				</a>
			</li>
		))
	}
</ol>
<ul class="extra not-content" aria-label="Дополнительные модули">
	{
		extra.map((s) => (
			<li>
				<a href={withBase(s.href)}>
					<span class="extra__tag">Модуль {s.n}</span>
					<strong>{s.t}</strong> — {s.d}
				</a>
			</li>
		))
	}
</ul>

<style>
	.path {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr));
		gap: 0.6rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		counter-reset: none;
	}
	.stage a {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		height: 100%;
		min-height: 44px;
		padding: 0.7rem 0.85rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-top: 3px solid var(--sl-color-accent);
		border-radius: var(--pcb-radius);
		background: var(--sl-color-gray-7, var(--sl-color-black));
		color: inherit;
		text-decoration: none;
	}
	.stage a:hover,
	.stage a:focus-visible {
		border-color: var(--sl-color-accent);
	}
	.stage__n {
		font-size: var(--sl-text-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--sl-color-accent);
	}
	.stage__t {
		font-weight: 650;
		color: var(--sl-color-white);
	}
	.stage__d {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.extra {
		display: grid;
		gap: 0.4rem;
		margin: 0.9rem 0 0;
		padding: 0;
		list-style: none;
	}
	.extra a {
		display: block;
		min-height: 44px;
		padding: 0.6rem 0.8rem;
		border: 1px dashed var(--sl-color-gray-5);
		border-radius: var(--pcb-radius);
		color: inherit;
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}
	.extra a:hover,
	.extra a:focus-visible {
		border-color: var(--sl-color-accent);
	}
	.extra__tag {
		margin-inline-end: 0.5rem;
		padding: 0.05rem 0.45rem;
		border-radius: 0.25rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		font-weight: 700;
	}
</style>
