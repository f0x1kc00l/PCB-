---
/**
 * Токоограничивающий резистор для светодиода (одного или цепочки последовательно).
 *   R = (Uпит − n·Uпр) / I
 */
const LEDS = [
	['red', 'красный', '2,0'],
	['orange', 'оранжевый', '2,1'],
	['yellow', 'жёлтый', '2,1'],
	['green-old', 'зелёный (обычный, жёлто-зелёный)', '2,1'],
	['green', 'зелёный яркий (InGaN)', '3,1'],
	['blue', 'синий', '3,1'],
	['white', 'белый', '3,1'],
	['ir', 'ИК (940 нм)', '1,3'],
] as const;
---

<led-calc class="pcb-widget pcb-calc not-content" data-leds={JSON.stringify(LEDS)}>
	<div class="pcb-widget__head">
		<p class="pcb-widget__title">Резистор для светодиода</p>
		<div class="pcb-widget__tools">
			<button type="button" class="pcb-tool" data-full aria-pressed="false" title="На весь экран" aria-label="На весь экран">⤢</button>
			<button type="button" class="pcb-tool" data-share title="Поделиться ссылкой на это состояние" aria-label="Поделиться ссылкой">🔗</button>
			<button type="button" class="pcb-reset" data-reset title="Вернуть исходные значения">↺ Сброс</button>
		</div>
	</div>
	<div class="fields">
		<label>Напряжение питания, В <input name="vs" value="5" inputmode="decimal" autocomplete="off" /></label>
		<label>Светодиод <select name="kind">{LEDS.map(([k, n]) => <option value={k} selected={k === 'red'}>{n}</option>)}</select></label>
		<label>Прямое напряжение Uпр, В <input name="vf" value="2,0" inputmode="decimal" autocomplete="off" /><span class="hint">типичное; точное — в даташите</span></label>
		<label>Сколько последовательно <input name="n" value="1" inputmode="numeric" autocomplete="off" /></label>
		<label>Ток, А <input name="i" value="10m" inputmode="decimal" autocomplete="off" /><span class="hint">индикатору на плате хватает 1–10 мА</span></label>
	</div>
	<div class="results">
		<div class="result"><span>Расчётное R</span><output data-o="r">—</output></div>
		<div class="result result--main"><span>Ставь (E24, с запасом вверх)</span><output data-o="re">—</output></div>
		<div class="result"><span>Реальный ток</span><output data-o="ir">—</output></div>
		<div class="result"><span>Мощность на R</span><output data-o="pr">—</output></div>
		<div class="result"><span>Мощность на светодиодах</span><output data-o="pl">—</output></div>
	</div>
	<ul class="warnings" data-warn></ul>
	<p class="footnote">
		Светодиод — это диод: выше Uпр ток растёт лавинообразно, поэтому напрямую к источнику напряжения его не подключают. Ток задаёт
		резистор: на нём падает остаток напряжения. Номинал берём ближайший больший — ток чуть меньше, чем хотели, а не больше.
	</p>
</led-calc>

<script>
	import '../../lib/reset';
	import { parseValue, formatValue, SERIES, seriesNeighbors } from '../../lib/units';

	const RATINGS = [0.125, 0.25, 0.5, 1, 2, 5];

	class LedCalc extends HTMLElement {
		connectedCallback() {
			const leds: [string, string, string][] = JSON.parse(this.dataset.leds!);
			const inp = (n: string) => this.querySelector<HTMLInputElement>(`input[name="${n}"]`)!;
			const kind = this.querySelector<HTMLSelectElement>('select[name="kind"]')!;
			const o = (n: string) => this.querySelector(`[data-o="${n}"]`)!;
			const warn = this.querySelector('[data-warn]')!;
			kind.addEventListener('change', () => {
				inp('vf').value = leds.find((l) => l[0] === kind.value)![2];
			});
			const update = () => {
				const vs = parseValue(inp('vs').value),
					vf = parseValue(inp('vf').value),
					n = Math.round(parseValue(inp('n').value)),
					i = parseValue(inp('i').value);
				const msgs: string[] = [];
				const head = vs - n * vf;
				const ok = vs > 0 && vf > 0 && n >= 1 && i > 0;
				if (!ok || head <= 0) {
					['r', 're', 'ir', 'pr', 'pl'].forEach((k) => (o(k).textContent = '—'));
					if (ok) msgs.push(`На ${n} светодиодах падает ${formatValue(n * vf, 'В')} — это не меньше питания. Уменьши число в цепочке или подними напряжение.`);
					warn.innerHTML = msgs.map((m) => `<li>${m}</li>`).join('');
					return;
				}
				const r = head / i;
				const re = seriesNeighbors(r, SERIES.E24.values).above;
				const ir = head / re;
				const pr = ir * ir * re;
				const rating = RATINGS.find((p) => p >= 2 * pr);
				o('r').textContent = formatValue(r, 'Ом');
				o('re').textContent = formatValue(re, 'Ом');
				o('ir').textContent = formatValue(ir, 'А');
				o('pr').textContent = `${formatValue(pr, 'Вт', 2)} → резистор ${rating ? String(rating).replace('.', ',') + ' Вт' : 'мощнее 5 Вт'}`;
				o('pl').textContent = formatValue(n * vf * ir, 'Вт', 2);
				if (head < 1)
					msgs.push(`На резисторе остаётся всего ${formatValue(head, 'В')}. Разброс Uпр от экземпляра к экземпляру (±0,2–0,3 В) сильно поменяет ток. Лучше больше запас или источник тока.`);
				if (ir > 0.03) msgs.push('Больше 30 мА — уже не индикаторный режим. Проверь максимальный ток по даташиту.');
				warn.innerHTML = msgs.map((m) => `<li>${m}</li>`).join('');
			};
			this.addEventListener('input', update);
			this.addEventListener('change', update);
			update();
		}
	}
	customElements.define('led-calc', LedCalc);
</script>
