---
/**
 * Рис. 8.7: размеры площадок SOT-223 по примеру разводки (Example Board Layout) из даташита TI LM1117, корпус DCY.
 * Масштаб 34 px = 1 мм, центр (250, 160).
 */
import Figure from '../Figure.astro';

const S = 34;
const cx = 250;
const cy = 160;
const row = 2.9 * S;
const lw = 0.95 * S;
const lh = 2.15 * S;
const tw = 3.25 * S;
const xs = [-2.3, 0, 2.3].map((x) => cx + x * S);
const leadTop = cy + row - lh / 2;
const tabTop = cy - row - lh / 2;
---

<Figure n="8.7" caption="Площадки SOT-223 по примеру разводки из даташита TI LM1117 (корпус DCY): три площадки 0,95 × 2,15 мм с шагом 2,3 мм, площадка фланца 3,25 × 2,15 мм, расстояние между осями рядов 5,8 мм. Это пример производителя, а не единственно верный вариант. Перед заказом сверяй с актуальной ревизией даташита.">
	<svg viewBox="0 0 640 330" role="img" aria-label="Посадочное место SOT-223 с размерами: ширина и длина площадок, шаг 2,3 миллиметра, ширина площадки фланца и расстояние между рядами 5,8 миллиметра.">
		<!-- оси рядов -->
		<path class="ln-dash" d={`M150 ${cy - row} H470 M150 ${cy + row} H470 M${cx} 50 V285`} />
		{xs.map((x, i) => (
			<g>
				<rect x={x - lw / 2} y={leadTop} width={lw} height={lh} fill="var(--pcb-copper)" />
				<text x={x} y={leadTop + lh / 2 + 5} text-anchor="middle" font-size="13" font-weight="700" fill="#111">{i + 1}</text>
			</g>
		))}
		<rect x={cx - tw / 2} y={tabTop} width={tw} height={lh} fill="var(--pcb-copper)" />
		<text x={cx} y={tabTop + lh / 2 + 5} text-anchor="middle" font-size="13" font-weight="700" fill="#111">4</text>
		<!-- 5,8 между рядами -->
		<path class="ln-acc" d={`M440 ${cy - row} V${cy + row} M434 ${cy - row} H446 M434 ${cy + row} H446`} />
		<text class="t t-acc t-mono" x="452" y={cy + 4}>5,8</text>
		<!-- шаг 2,3 -->
		<path class="ln-acc" d={`M${xs[0]} 300 H${xs[1]} M${xs[0]} 294 V306 M${xs[1]} 294 V306`} />
		<text class="t t-acc t-mono" x={(xs[0] + xs[1]) / 2} y="320" text-anchor="middle">2,3</text>
		<!-- ширина площадки 0,95 -->
		<path class="ln" d={`M${xs[2] - lw / 2} 300 H${xs[2] + lw / 2} M${xs[2] - lw / 2} 294 V306 M${xs[2] + lw / 2} 294 V306`} />
		<text class="t t-mono t-s" x={xs[2] + 22} y="320">0,95</text>
		<!-- длина площадки 2,15 -->
		<path class="ln" d={`M${xs[0] - 40} ${leadTop} V${leadTop + lh} M${xs[0] - 46} ${leadTop} H${xs[0] - 34} M${xs[0] - 46} ${leadTop + lh} H${xs[0] - 34}`} />
		<text class="t t-mono t-s" x={xs[0] - 50} y={leadTop + lh / 2 + 4} text-anchor="end">2,15</text>
		<!-- ширина фланца 3,25 -->
		<path class="ln" d={`M${cx - tw / 2} 26 H${cx + tw / 2} M${cx - tw / 2} 20 V32 M${cx + tw / 2} 20 V32`} />
		<text class="t t-mono t-s" x={cx} y="16" text-anchor="middle">3,25</text>
		<!-- назначение выводов -->
		<g class="t t-s">
			<text x="500" y="70">1 — GND (ADJ)</text>
			<text x="500" y="90">2 — VOUT</text>
			<text x="500" y="110">3 — VIN</text>
			<text x="500" y="130">4 (фланец) — VOUT</text>
			<text x="500" y="160" class="t-mut">размеры в мм</text>
		</g>
	</svg>
</Figure>
