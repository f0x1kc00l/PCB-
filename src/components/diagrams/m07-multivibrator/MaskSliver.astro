---
/**
 * Рис. 7.4: почему DRC ругается на выводы TO-92. Две соседние площадки с зазором по меди 0,22 мм;
 * окна в маске расширены на 0,1016 мм с каждой стороны, и между окнами остаётся полоска маски ≈ 0,017 мм.
 * Масштаб условный: 1 мм ≈ 110 px.
 */
import Figure from '../Figure.astro';

const k = 110; // px на мм
const r = 0.6 * k; // радиус площадки (условно)
const gap = 0.22 * k;
const exp = 0.1016 * k;
const cx1 = 110;
const cx2 = cx1 + 2 * r + gap;
const cy = 140;
---

<Figure n="7.4" caption="Слева направо: медь площадок (оранжевая), окна в паяльной маске (пунктир) расширены на 0,1 мм. Медный зазор 0,22 мм меньше правила Clearance 0,25 мм, а между окнами маски остаётся полоска шириной около 0,017 мм — меньше минимальной Solder Mask Sliver. Масштаб условный.">
	<svg viewBox="0 0 560 300" role="img" aria-label="Две круглые площадки рядом. Пунктирные окна маски шире площадок, между ними узкая полоска маски. Подписаны зазор по меди 0,22 мм и полоска маски 0,017 мм.">
		<rect x="10" y="20" width="540" height="260" fill="var(--pcb-mask)" opacity="0.55" rx="6" />
		{[cx1, cx2].map((x) => (
			<g>
				<circle cx={x} cy={cy} r={r + exp} fill="var(--sl-color-bg)" opacity="0.75" />
				<circle cx={x} cy={cy} r={r + exp} fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 4" />
				<circle cx={x} cy={cy} r={r} fill="var(--pcb-copper)" />
				<circle cx={x} cy={cy} r={r * 0.4} fill="#0e1712" />
			</g>
		))}
		<!-- зазор по меди -->
		<path class="ln" d={`M${cx1 + r} ${cy - r - 34} V${cy - 8} M${cx2 - r} ${cy - r - 34} V${cy - 8}`} stroke-dasharray="3 3" />
		<path class="ln-acc" d={`M${cx1 + r} ${cy - r - 26} H${cx2 - r}`} />
		<text class="t t-acc" x={(cx1 + cx2) / 2} y={cy - r - 40} text-anchor="middle">медь: 0,22 мм</text>
		<!-- полоска маски -->
		<path class="ln-acc" d={`M${(cx1 + cx2) / 2} ${cy + 40} V${cy + r + 40}`} />
		<text class="t" x={(cx1 + cx2) / 2} y={cy + r + 58} text-anchor="middle">полоска маски ≈ 0,22 − 2·0,1016 ≈ 0,017 мм</text>
		<text class="t t-s" x="24" y="44">паяльная маска</text>
		<text class="t t-s" x={cx2 + r + exp + 10} y={cy - r}>окно в маске</text>
		<text class="t t-s" x={cx2 + r + exp + 10} y={cy - r + 16}>(+0,1016 мм)</text>
	</svg>
</Figure>
