---
/** Рис. к уроку 1.6: модель реального источника напряжения и его нагрузочная характеристика. */
import Figure from './Figure.astro';
---

<Figure n="1.7" caption="Реальный источник = идеальный источник Uхх плюс внутреннее сопротивление Rвн. Чем больше ток нагрузки, тем больше напряжения «теряется» внутри: Uвых = Uхх − I·Rвн. При коротком замыкании ток ограничен только Rвн: Iкз = Uхх / Rвн.">
	<svg viewBox="0 0 640 240" role="img" aria-label="Слева: пунктирная рамка реального источника с идеальным источником и внутренним сопротивлением, к выходу подключена нагрузка. Справа: график выходного напряжения от тока — наклонная прямая от Uхх до Iкз и горизонтальная пунктирная линия идеального источника.">
		<!-- рамка источника -->
		<rect x="20" y="30" width="190" height="180" rx="8" class="ln-dash" />
		<text class="t t-s t-mut" x="30" y="24">реальный источник</text>
		<!-- идеальный источник: круг с плюсом -->
		<circle class="ln" cx="70" cy="120" r="22" />
		<text class="t" x="70" y="114" text-anchor="middle" font-weight="700">+</text>
		<text class="t" x="70" y="133" text-anchor="middle" font-weight="700">−</text>
		<text class="t t-acc" x="70" y="160" text-anchor="middle">Uхх</text>
		<path class="ln" d="M70 98 V60 H110 M150 60 H250 M70 142 V180 H250" />
		<rect class="ln" x="110" y="53" width="40" height="14" />
		<text class="t t-acc" x="130" y="88" text-anchor="middle">Rвн</text>
		<!-- выход и нагрузка -->
		<circle class="ln" cx="214" cy="60" r="4" />
		<circle class="ln" cx="214" cy="180" r="4" />
		<path class="ln" d="M250 60 V100 M250 140 V180" />
		<rect class="ln" x="243" y="100" width="14" height="40" />
		<text class="t" x="266" y="124">Rн</text>
		<path class="ln-acc" d="M170 48 H200 M193 42 L200 48 L193 54" />
		<text class="t t-acc t-s" x="172" y="40">I</text>

		<!-- ===== График ===== -->
		<path class="ln" d="M360 200 H620 M360 200 V30" />
		<text class="t t-s" x="620" y="220" text-anchor="end">I</text>
		<text class="t t-s" x="350" y="34" text-anchor="end">Uвых</text>
		<path class="ln-dash" d="M360 60 H600" />
		<text class="t t-s t-mut" x="600" y="54" text-anchor="end">идеальный источник</text>
		<path class="ln-acc" d="M360 60 L580 200" />
		<text class="t t-acc t-s" x="350" y="64" text-anchor="end">Uхх</text>
		<text class="t t-acc t-s" x="580" y="218" text-anchor="middle">Iкз</text>
		<text class="t t-s" x="480" y="118">наклон = −Rвн</text>
	</svg>
</Figure>
