---
/**
 * Рис. 12.3 к уроку 12.2: поперечные сечения печатных линий передачи —
 * микрополосковая, полосковая (симметричная), копланарная с землёй (CPWG) и щелевая.
 */
import Figure from '../Figure.astro';
---

<Figure n="12.2а" caption="Четыре печатные линии в разрезе. Микрополосок — дорожка над землёй на внешнем слое. Полосковая (симметричная) — дорожка между двумя землями внутри платы. Копланарная с землёй (CPWG) — дорожка с земляными полигонами по бокам на том же слое и землёй снизу, полигоны сшиты переходными отверстиями. Щелевая — узкая щель в сплошной металлизации.">
	<svg viewBox="0 0 660 330" role="img" aria-label="Четыре поперечных сечения линий передачи на диэлектрике с медью.">
		<!-- ===== Микрополосок ===== -->
		<text class="t" x="10" y="18" font-weight="700">Микрополосковая (microstrip)</text>
		<rect x="20" y="55" width="280" height="50" fill="var(--pcb-fr4)" opacity="0.55" />
		<rect x="20" y="105" width="280" height="8" fill="var(--pcb-copper)" />
		<rect x="135" y="47" width="50" height="8" fill="var(--pcb-copper)" />
		<text class="t t-s t-mut" x="160" y="132" text-anchor="middle">поле частично в воздухе → квази-ТЕМ</text>

		<!-- ===== Полосковая ===== -->
		<text class="t" x="350" y="18" font-weight="700">Полосковая (stripline)</text>
		<rect x="360" y="35" width="280" height="8" fill="var(--pcb-copper)" />
		<rect x="360" y="43" width="280" height="62" fill="var(--pcb-fr4)" opacity="0.55" />
		<rect x="360" y="105" width="280" height="8" fill="var(--pcb-copper)" />
		<rect x="475" y="70" width="50" height="8" fill="var(--pcb-copper)" />
		<text class="t t-s t-mut" x="500" y="132" text-anchor="middle">поле целиком в диэлектрике → ТЕМ, экранирована</text>

		<!-- ===== CPWG ===== -->
		<text class="t" x="10" y="178" font-weight="700">Копланарная с землёй (CPWG)</text>
		<rect x="20" y="215" width="280" height="50" fill="var(--pcb-fr4)" opacity="0.55" />
		<rect x="20" y="265" width="280" height="8" fill="var(--pcb-copper)" />
		<rect x="20" y="207" width="98" height="8" fill="var(--pcb-copper)" />
		<rect x="137" y="207" width="46" height="8" fill="var(--pcb-copper)" />
		<rect x="202" y="207" width="98" height="8" fill="var(--pcb-copper)" />
		<rect x="60" y="215" width="8" height="50" fill="var(--pcb-copper)" opacity="0.8" />
		<rect x="252" y="215" width="8" height="50" fill="var(--pcb-copper)" opacity="0.8" />
		<path class="ln" d="M137 196 H183 M137 191 V201 M183 191 V201" />
		<text class="t t-s t-acc" x="160" y="188" text-anchor="middle">W</text>
		<path class="ln" d="M118 222 H137" />
		<text class="t t-s t-acc" x="127" y="238" text-anchor="middle">s</text>
				<text class="t t-s t-mut" x="185" y="292" text-anchor="middle">боковые земли сшиты с нижней</text>
		<text class="t t-s t-mut" x="185" y="306" text-anchor="middle">переходными отверстиями</text>

		<!-- ===== Щелевая ===== -->
		<text class="t" x="350" y="178" font-weight="700">Щелевая (slotline)</text>
		<rect x="360" y="215" width="280" height="50" fill="var(--pcb-fr4)" opacity="0.55" />
		<rect x="360" y="207" width="128" height="8" fill="var(--pcb-copper)" />
		<rect x="512" y="207" width="128" height="8" fill="var(--pcb-copper)" />
		<path class="ln" d="M488 196 H512 M488 191 V201 M512 191 V201" />
		<text class="t t-s t-acc" x="500" y="188" text-anchor="middle">щель</text>
		<text class="t t-s t-mut" x="500" y="292" text-anchor="middle">без нижней земли; волна не ТЕМ</text>
		<text class="t t-s t-mut" x="500" y="306" text-anchor="middle">на обычных платах редкость</text>
	</svg>
</Figure>
