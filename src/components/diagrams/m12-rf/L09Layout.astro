		<text class="t t-s" x="160" y="138" text-anchor="middle" style="fill:#ddd">20 × 14 мм</text>
		{halfL.map((x) => (
			<g>
				<rect x={x} y="52" width="12" height="14" fill="var(--pcb-copper)" />
				<rect x={x} y="194" width="12" height="14" fill="var(--pcb-copper)" />
			</g>
		))}
		<!-- ANT площадка, справа снизу -->
