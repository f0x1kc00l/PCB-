---
/**
 * Рис. к уроку 12.9: эскиз топологии ВЧ-части узла LoRa: модуль, линия CPWG, П-цепь, торцевой SMA.
 */
import Figure from '../Figure.astro';

const fence: number[] = [];
for (let x = 300; x <= 560; x += 20) if (x < 370 || x > 470) fence.push(x);
const halfL = Array.from({ length: 7 }, (_, i) => 70 + i * 22);
---

<Figure n="12.9б" caption="Эскиз верхнего слоя ВЧ-части. Модуль стоит у края платы, вывод ANT (21) смотрит на разъём. Линия 50 Ом — короткая и прямая, CPWG с рядами переходных отверстий с шагом около 3–5 мм. Площадки П-цепи стоят на линии без разрыва зазоров. Торцевой SMA — на краю, его земляные лапки прошиты отверстиями. Под модулем — сплошная земля без дорожек; второй слой — тоже сплошная земля. Размеры условные.">
	<svg viewBox="0 0 660 300" role="img" aria-label="Вид сверху: плата, слева модуль с контактными площадками по краям, от его правой нижней площадки ANT идёт линия 50 Ом с двумя рядами переходных отверстий, площадками П-цепи и торцевым разъёмом SMA на правом краю.">
		<rect x="20" y="20" width="600" height="260" rx="6" fill="var(--pcb-mask)" opacity="0.85" />
		<rect x="28" y="28" width="592" height="244" fill="var(--pcb-copper)" opacity="0.3" />
