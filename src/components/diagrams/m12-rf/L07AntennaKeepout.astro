---
/**
 * Рис. к уроку 12.7: угол платы с чип-антенной. Зона без меди на всех слоях,
 * линия питания 50 Ом (CPWG) с забором из переходных отверстий, площадки П-цепи.
 */
import Figure from '../Figure.astro';

// переходные отверстия вдоль линии
const vias: number[] = [];
for (let x = 70; x <= 300; x += 22) vias.push(x);
---

<Figure n="12.7а" caption="Чип-антенна в углу платы. Под антенной и вокруг неё — зона без меди на всех слоях (keep-out); размеры зоны берут из даташита антенны. Линия питания — копланарная с землёй (CPWG) на 50 Ом, по обе стороны ряды переходных отверстий на нижнюю землю. Перед антенной — площадки П-цепи: последовательная и две параллельные к земле.">
	<svg viewBox="0 0 640 300" role="img" aria-label="Вид сверху на угол платы: слева полигон земли с линией 50 Ом и рядами переходных отверстий, справа сверху прямоугольная зона без меди с чип-антенной, между ними три площадки согласующей цепи.">
		<!-- плата -->
		<rect x="20" y="20" width="600" height="260" rx="6" fill="var(--pcb-mask)" opacity="0.85" />
		<!-- земля (полигон) — всё кроме keep-out -->
		<path d="M28 28 H418 V170 H612 V272 H28 Z" fill="var(--pcb-copper)" opacity="0.35" />
		<!-- keep-out -->
		<rect x="418" y="28" width="194" height="142" fill="var(--sl-color-bg)" opacity="0.92" />
		<rect x="418" y="28" width="194" height="142" class="ln-dash" />
		<text class="t t-s" x="515" y="48" text-anchor="middle">зона без меди</text>
		<text class="t t-s t-mut" x="515" y="63" text-anchor="middle">на ВСЕХ слоях</text>
		<!-- чип-антенна -->
		<rect x="470" y="88" width="110" height="32" rx="3" fill="#2a2a2a" />
		<rect x="470" y="88" width="16" height="32" fill="#c8c8c8" />
		<rect x="564" y="88" width="16" height="32" fill="#c8c8c8" />
		<text class="t t-s" x="525" y="140" text-anchor="middle">чип-антенна</text>
		<text class="t t-s t-mut" x="525" y="154" text-anchor="middle">(вывод 2 — для крепления)</text>
		<!-- линия CPWG с зазорами -->
		<rect x="40" y="200" width="300" height="24" fill="var(--sl-color-bg)" opacity="0.92" />
		<rect x="40" y="206" width="300" height="12" fill="var(--pcb-copper)" />
		<!-- П-цепь: последовательный элемент и два на землю -->
		<rect x="340" y="200" width="70" height="24" fill="var(--sl-color-bg)" opacity="0.92" />
		<rect x="345" y="204" width="14" height="16" fill="var(--pcb-copper)" />
		<rect x="368" y="204" width="14" height="16" fill="var(--pcb-copper)" />
		<rect x="390" y="204" width="14" height="16" fill="var(--pcb-copper)" />
		<path d="M404 212 H440 V120 H476" fill="none" stroke="var(--pcb-copper)" stroke-width="10" />
		<rect x="338" y="178" width="14" height="18" fill="var(--pcb-copper)" stroke="var(--sl-color-accent)" stroke-width="1.5" />
		<rect x="397" y="178" width="14" height="18" fill="var(--pcb-copper)" stroke="var(--sl-color-accent)" stroke-width="1.5" />
		<text class="t t-s" x="374" y="170" text-anchor="middle" font-weight="700">П-цепь</text>
		<!-- переходные отверстия -->
		{vias.map((x) => (
			<g>
				<circle cx={x} cy="190" r="4.5" fill="var(--pcb-copper)" />
				<circle cx={x} cy="190" r="2" fill="#111" />
				<circle cx={x} cy="234" r="4.5" fill="var(--pcb-copper)" />
				<circle cx={x} cy="234" r="2" fill="#111" />
			</g>
		))}
		<!-- подписи -->
		<path class="ln-acc" d="M120 258 V226" />
		<text class="t t-s" x="40" y="270">линия 50 Ом (CPWG): дорожка W, зазор S до земли</text>
		<path class="ln-acc" d="M180 146 V184" />
		<text class="t t-s" x="110" y="140">ряд переходных отверстий на нижнюю землю</text>
		<text class="t t-s" x="40" y="176">от трансивера</text>
	</svg>
</Figure>
