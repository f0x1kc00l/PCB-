---
/**
 * Рис. к уроку 12.8: экран над ВЧ-узлом — это металлическая коробка, т.е. резонатор.
 * Слева разрез, справа формула нижнего резонанса и пример.
 */
import Figure from '../Figure.astro';
---

<Figure n="12.8б" caption="Экран (shield can) — металлическая коробка над ВЧ-узлом, впаянная в рамку из земли. Вместе с землёй платы он образует объёмный резонатор. Его нижняя резонансная частота должна быть заметно выше рабочей, иначе экран вместо защиты начнёт «звенеть». Малорацкий в §1.7 подробно разбирает этот эффект для корпусов ГИС СВЧ.">
	<svg viewBox="0 0 640 220" role="img" aria-label="Слева разрез: плата, на ней трансивер, сверху металлическая крышка высотой H, стенки впаяны в землю. Справа формула резонансной частоты прямоугольной коробки и пример для 20 на 15 мм.">
		<!-- плата -->
		<rect x="20" y="150" width="300" height="30" fill="var(--pcb-fr4)" opacity="0.6" />
		<rect x="20" y="144" width="300" height="6" fill="var(--pcb-copper)" />
		<rect x="20" y="180" width="300" height="6" fill="var(--pcb-copper)" />
		<!-- экран -->
		<path d="M60 144 V70 H280 V144" fill="none" stroke="#9aa3ad" stroke-width="5" />
		<rect x="130" y="128" width="60" height="16" fill="#2a2a2a" />
		<rect x="210" y="138" width="40" height="6" fill="var(--pcb-copper)" />
		<path class="ln" d="M300 70 V144 M295 70 H305 M295 144 H305" />
		<text class="t t-s" x="308" y="112">H</text>
		<path class="ln" d="M60 52 H280 M60 47 V57 M280 47 V57" />
		<text class="t t-s" x="170" y="44" text-anchor="middle">a (и b вглубь)</text>
		<text class="t t-s t-mut" x="170" y="205" text-anchor="middle">стенки впаяны в рамку земли с переходными</text>

		<text class="t" x="350" y="70" font-weight="700">Нижний резонанс пустой коробки</text>
		<text class="t t-mono" x="350" y="100">f ≈ (c/2)·√(1/a² + 1/b²)</text>
		<text class="t t-s" x="350" y="130">a = 20 мм, b = 15 мм → f ≈ 12,5 ГГц</text>
		<text class="t t-s" x="350" y="150">a = 50 мм, b = 40 мм → f ≈ 4,8 ГГц</text>
		<text class="t t-s t-mut" x="350" y="178">Подложка с εr внутри понижает частоту.</text>
		<text class="t t-s t-mut" x="350" y="194">Для LoRa 868 МГц маленький экран безопасен,</text>
		<text class="t t-s t-mut" x="350" y="210">для Wi-Fi 5 ГГц большой — уже нет.</text>
	</svg>
</Figure>
