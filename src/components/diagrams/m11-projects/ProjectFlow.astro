---
/** Рис. 11.10: маршрут собственного проекта с контрольными точками (ревью). */
import Figure from '../Figure.astro';

const steps = [
	{ t: 'ТЗ', s: 'что и зачем' },
	{ t: 'Схема', s: 'расчёты, даташиты' },
	{ t: 'Ревью схемы', s: 'чек-лист, ERC', gate: true },
	{ t: 'Библиотека', s: 'символы, посадочные' },
	{ t: 'Топология', s: 'размещение, трассы' },
	{ t: 'Ревью платы', s: 'DRC, чек-лист', gate: true },
	{ t: 'Выпуск', s: 'Gerber, BOM, чертёж' },
	{ t: 'Заказ и запуск', s: 'сборка, проверка' },
];
const W = 150;
const H = 62;
const pos = (i: number) => ({ x: 20 + (i % 4) * (W + 20), y: i < 4 ? 30 : 150 });
---

<Figure n="11.10" caption="Маршрут собственного проекта. Ромбики — контрольные точки (ревью). Дальше этапа ревью нельзя идти, пока чек-лист не закрыт целиком: ошибка, пойманная на схеме, стоит минуты, пойманная на собранной плате — недели и деньги.">
	<svg viewBox="0 0 700 240" role="img" aria-label="Восемь этапов в два ряда: ТЗ, схема, ревью схемы, библиотека, топология, ревью платы, выпуск, заказ и запуск. Ревью отмечены как контрольные точки.">
		{
			steps.map((st, i) => {
				const { x, y } = pos(i);
				return (
					<g>
						<rect class={st.gate ? 'ln-acc' : 'ln'} x={x} y={y} width={W} height={H} rx={st.gate ? 2 : 8} />
						{st.gate && <path class="fill-acc" d={`M${x + W - 18} ${y + 6} l8 8 l-8 8 l-8 -8 Z`} />}
						<text class="t" x={x + 12} y={y + 26} font-weight="700">{i + 1}. {st.t}</text>
						<text class="t t-s t-mut" x={x + 12} y={y + 46}>{st.s}</text>
						{i % 4 !== 3 && <path class="ln" d={`M${x + W} ${y + H / 2} H${x + W + 20} M${x + W + 14} ${y + H / 2 - 5} L${x + W + 20} ${y + H / 2} L${x + W + 14} ${y + H / 2 + 5}`} />}
					</g>
				);
			})
		}
		<path class="ln" d={`M${pos(3).x + W / 2} ${30 + H} V120 H${pos(4).x + W / 2} V150 M${pos(4).x + W / 2 - 5} 144 L${pos(4).x + W / 2} 150 L${pos(4).x + W / 2 + 5} 144`} />
	</svg>
</Figure>
