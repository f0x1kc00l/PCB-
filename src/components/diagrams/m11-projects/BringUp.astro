---
/**
 * Рис. 11.12 / 11.13: порядок первого включения новой платы.
 * Пропс variant: 'power' — плата питания (11.1.3), 'mcu' — плата с микроконтроллером (11.2.5).
 */
import Figure from '../Figure.astro';

interface Props {
	variant: 'power' | 'mcu';
}
const { variant } = Astro.props;

const common = [
	{ t: 'Осмотр', s: ['перемычки,', 'полярность'] },
	{ t: 'Прозвонка', s: ['питание', '↔ GND'] },
	{ t: 'Питание', s: ['с ограничением', 'тока'] },
	{ t: 'Напряжения', s: ['в контрольных', 'точках'] },
];
const tail =
	variant === 'power'
		? [
				{ t: 'Нагрузка', s: ['0,5 А', 'при 5 В'] },
				{ t: 'Тепло', s: ['150 мА', 'при 12 В'] },
				{ t: 'Протокол', s: ['по пунктам', 'ТЗ'] },
			]
		: [
				{ t: 'USB', s: ['COM-порт', 'CH340'] },
				{ t: 'ISP', s: ['фьюзы +', 'загрузчик'] },
				{ t: 'Blink', s: ['по USB,', 'автосброс'] },
			];
const steps = [...common, ...tail];
const W = 98;
const gap = 12;
const n = variant === 'power' ? '11.12' : '11.13';
---

<Figure n={n} caption="Порядок первого включения. Каждый шаг проверяет одно предположение. Если шаг не прошёл — дальше не идём: следующий шаг может сжечь плату или замаскировать причину ошибки.">
	<svg viewBox={`0 0 ${steps.length * (W + gap) + 10} 124`} role="img" aria-label={`Шаги запуска: ${steps.map((s) => s.t).join(', ')}.`}>
		{
			steps.map((st, i) => {
				const x = 10 + i * (W + gap);
				return (
					<g>
						<rect class={i < 4 ? 'ln' : 'ln-acc'} x={x} y="14" width={W} height="96" rx="8" />
						<text class="t t-acc" x={x + W / 2} y="42" text-anchor="middle" font-weight="700">{i + 1}</text>
						<text class="t t-s" x={x + W / 2} y="62" text-anchor="middle" font-weight="700">{st.t}</text>
						<text class="t t-s t-mut" x={x + W / 2} y="82" text-anchor="middle">{st.s[0]}</text>
						<text class="t t-s t-mut" x={x + W / 2} y="97" text-anchor="middle">{st.s[1]}</text>
						{i < steps.length - 1 && <path class="ln" d={`M${x + W} 58 H${x + W + gap} M${x + W + gap - 5} 53 L${x + W + gap} 58 L${x + W + gap - 5} 63`} />}
					</g>
				);
			})
		}
	</svg>
</Figure>
