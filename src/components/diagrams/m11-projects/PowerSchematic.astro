---
/**
 * Рис. 11.2: принципиальная схема платы питания (проект 11.1).
 * Детали и номиналы — из даташитов: TI LM1117 (SNOS412), Diodes DMP3099L.
 */
import Figure from '../Figure.astro';
import { text, wire, dot, gnd, resV, capV, ledV, tp, box } from './sym';

const G = 262; // y шины земли
const Y = 100; // y шины питания
const da1 = box(360, 70, 110, 70, 'DA1', 'LM1117-3.3', [
	{ side: 'L', at: 30, num: '3', name: 'IN' },
	{ side: 'R', at: 30, num: '2, 4', name: 'OUT' },
	{ side: 'B', at: 55, num: '1', name: 'GND' },
]);
const j1 = box(20, 80, 34, 70, 'J1', 'DC 5–12 В', [
	{ side: 'R', at: 20, num: '1', name: '+' },
	{ side: 'R', at: 52, num: '2', name: '−' },
]);
const j2 = box(640, 80, 34, 70, 'J2', 'выход', [
	{ side: 'L', at: 20, num: '1', name: '3V3' },
	{ side: 'L', at: 52, num: '2', name: '⏚' },
]);

const parts = [
	j1.svg,
	da1.svg,
	j2.svg,
	// J1 «+» → VT1 (сток)
	wire([[70, Y], [150, Y]]),
	// VT1: P-канальный МОП-транзистор, сток слева, исток справа, затвор вниз
	`<circle class="ln" cx="180" cy="${Y + 4}" r="20" />`,
	`<path class="ln" d="M150 ${Y} H168 V${Y + 8} M192 ${Y + 8} V${Y} H210 M164 ${Y + 8} H172 M176 ${Y + 8} H184 M188 ${Y + 8} H196 M166 ${Y + 15} H194 M180 ${Y + 15} V${Y + 30}" />`,
	text(180, Y - 1, 'P', 't t-s t-mut', 'middle'),
	text(180, Y - 24, 'VT1 DMP3099L', 't t-s t-acc', 'middle'),
	text(156, Y - 6, 'D', 't t-s t-mut', 'middle'),
	text(204, Y - 6, 'S', 't t-s t-mut', 'middle'),
	text(188, Y + 44, 'G', 't t-s t-mut'),
	resV(180, Y + 30, G, 'R1', '100 кОм'),
	// исток → узел VIN
	wire([[210, Y], [344, Y]]),
	dot(250, Y),
	dot(300, Y),
	capV(250, Y, G, 'C1', '10 мкФ', false, 'L'),
	capV(300, Y, G, 'C2', '100 нФ', false, 'R'),
	tp(230, 60, 'TP1'),
	wire([[230, 65], [230, Y]]),
	text(275, Y - 8, 'VIN', 't t-s t-mono'),
	// выход
	wire([[486, Y], [624, Y]]),
	dot(520, Y),
	dot(580, Y),
	capV(520, Y, G, 'C3', '10 мкФ тант.', true, 'R'),
	resV(580, Y, 185, 'R2', '1 кОм', 'R'),
	ledV(580, 185, G, 'HL1'),
	tp(550, 60, 'TP2'),
	wire([[550, 65], [550, Y]]),
	text(600, Y - 8, '+3V3', 't t-s t-mono t-acc'),
	// земля
	wire([[70, 132], [86, 132], [86, G]]),
	wire([[86, G], [624, G]]),
	wire([[415, 156], [415, G]]),
	wire([[624, 132], [610, 132], [610, G]]),
	dot(180, G), dot(250, G), dot(300, G), dot(415, G), dot(520, G), dot(580, G), dot(610, G),
	gnd(340, G),
	tp(120, G - 30, 'TP3'),
	wire([[120, G - 25], [120, G]]),
	dot(120, G),
];
---

<Figure n="11.2" caption="Принципиальная схема платы питания. VT1 защищает от переполюсовки почти без потерь напряжения. C1 и C3 — обязательные конденсаторы по даташиту LM1117, C3 — танталовый с ESR 0,3–22 Ом: от этого зависит устойчивость стабилизатора. HL1 показывает наличие 3,3 В, TP1–TP3 — точки для щупов.">
	<svg viewBox="0 0 700 300" role="img" aria-label="Схема: разъём J1, P-канальный транзистор VT1 с резистором R1 в затворе, конденсаторы C1 и C2, стабилизатор DA1 LM1117-3.3, танталовый конденсатор C3, резистор R2 и светодиод HL1, выходной разъём J2, контрольные точки TP1–TP3.">
		<g set:html={parts.join('')} />
	</svg>
</Figure>
