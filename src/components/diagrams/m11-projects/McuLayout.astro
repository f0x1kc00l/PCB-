---
/**
 * Рис. 11.9: эскиз размещения платы 11.2 (25×55 мм, вид сверху). Масштаб 8 px = 1 мм. Схематично.
 */
import Figure from '../Figure.astro';

const S = 8;
const ox = 40;
const oy = 30;
const mm = (v: number) => v * S;
const pinsTop = Array.from({ length: 15 }, (_, i) => i);
---

<Figure n="11.9" caption="Эскиз размещения 55×25 мм. USB-C на короткой кромке, USBLC6 вплотную к нему, CH340C рядом, пара D+/D− короткая, идёт рядом и симметрично над сплошной землёй нижнего слоя. Кварц — в паре миллиметров от выводов 7 и 8, под ним никаких чужих дорожек. Конденсаторы развязки — у каждого вывода питания. Гребёнки — по длинным кромкам с шагом 2,54 мм, ISP — на дальнем конце.">
	<svg viewBox="0 0 540 300" role="img" aria-label="Эскиз платы: слева разъём USB-C, рядом защита ESD и CH340C, в центре ATmega328P с кварцем и конденсаторами, справа разъём ISP и кнопка, сверху и снизу ряды выводов гребёнок.">
		<rect x={ox} y={oy} width={mm(55)} height={mm(25)} rx="8" fill="var(--pcb-mask)" />
		<!-- гребёнки -->
		{pinsTop.map((i) => (
			<g>
				<circle cx={ox + mm(9 + i * 2.54)} cy={oy + mm(1.8)} r="6" fill="var(--pcb-copper)" />
				<circle cx={ox + mm(9 + i * 2.54)} cy={oy + mm(23.2)} r="6" fill="var(--pcb-copper)" />
			</g>
		))}
		<text class="t t-s" x={ox + mm(28)} y={oy + mm(5.4)} text-anchor="middle" fill="#fff">XP1 (D0–D13)</text>
		<text class="t t-s" x={ox + mm(28)} y={oy + mm(21.2)} text-anchor="middle" fill="#fff">XP2 (A0–A7, питание)</text>
		<!-- USB-C -->
		<rect x={ox - mm(1)} y={oy + mm(8.5)} width={mm(7.5)} height={mm(9)} fill="#9aa3ad" />
		<text class="t t-s" x={ox + mm(2.8)} y={oy + mm(13.6)} text-anchor="middle" fill="#111">XS1</text>
		<!-- ESD -->
		<rect x={ox + mm(8.5)} y={oy + mm(11.5)} width={mm(3)} height={mm(3)} fill="#222" stroke="#bbb" />
		<text class="t t-s" x={ox + mm(10)} y={oy + mm(17.5)} text-anchor="middle" fill="#fff">DA1</text>
		<!-- CH340C SOIC-16 -->
		<rect x={ox + mm(14)} y={oy + mm(9)} width={mm(10)} height={mm(4)} fill="#222" stroke="#bbb" />
		<text class="t t-s" x={ox + mm(19)} y={oy + mm(11.6)} text-anchor="middle" fill="#fff">DD1</text>
		<!-- дифпара D+/D− -->
		<path d={`M${ox + mm(6.5)} ${oy + mm(12.5)} H${ox + mm(8.5)} M${ox + mm(11.5)} ${oy + mm(12.5)} H${ox + mm(13)} L${ox + mm(14)} ${oy + mm(11.8)}`} stroke="var(--sl-color-accent)" stroke-width="3" fill="none" />
		<path d={`M${ox + mm(6.5)} ${oy + mm(13.5)} H${ox + mm(8.5)} M${ox + mm(11.5)} ${oy + mm(13.5)} H${ox + mm(13.4)} L${ox + mm(14.6)} ${oy + mm(12.3)}`} stroke="var(--sl-color-accent)" stroke-width="3" fill="none" />
		<text class="t t-s t-acc" x={ox + mm(10)} y={oy + mm(9.6)} text-anchor="middle">D+/D−</text>
		<!-- MCU TQFP-32 -->
		<rect x={ox + mm(28)} y={oy + mm(8.5)} width={mm(9)} height={mm(9)} fill="#222" stroke="#bbb" transform={`rotate(45 ${ox + mm(32.5)} ${oy + mm(13)})`} />
		<text class="t t-s" x={ox + mm(32.5)} y={oy + mm(13.6)} text-anchor="middle" fill="#fff">DD2</text>
		<!-- кварц и конденсаторы -->
		<rect x={ox + mm(24.5)} y={oy + mm(14.5)} width={mm(3.2)} height={mm(2.5)} fill="#ddd" />
		<text class="t t-s" x={ox + mm(24)} y={oy + mm(16.3)} text-anchor="end" fill="#fff">ZQ1</text>
		{[[30, 7], [36.5, 9.5], [38, 16], [27.5, 9]].map(([x, y]) => (
			<rect x={ox + mm(x)} y={oy + mm(y)} width={mm(1.6)} height={mm(0.8)} fill="#c9a36a" />
		))}
		<!-- ISP и кнопка -->
		<g>
			{[0, 1, 2].map((i) => [0, 1].map((j) => <circle cx={ox + mm(47 + i * 2.54)} cy={oy + mm(10.5 + j * 2.54)} r="5.5" fill="var(--pcb-copper)" />))}
		</g>
		<text class="t t-s" x={ox + mm(49.5)} y={oy + mm(17.8)} text-anchor="middle" fill="#fff">XP3 ISP</text>
		<rect x={ox + mm(40)} y={oy + mm(9.5)} width={mm(4)} height={mm(3)} fill="#888" />
		<text class="t t-s" x={ox + mm(42)} y={oy + mm(15.4)} text-anchor="middle" fill="#fff">SB1</text>
		<!-- размеры -->
		<path class="ln" d={`M${ox} ${oy + mm(25) + 18} H${ox + mm(55)} M${ox} ${oy + mm(25) + 12} V${oy + mm(25) + 24} M${ox + mm(55)} ${oy + mm(25) + 12} V${oy + mm(25) + 24}`} />
		<text class="t t-s" x={ox + mm(27.5)} y={oy + mm(25) + 36} text-anchor="middle">55 мм</text>
		<path class="ln" d={`M${ox + mm(55) + 18} ${oy} V${oy + mm(25)} M${ox + mm(55) + 12} ${oy} H${ox + mm(55) + 24} M${ox + mm(55) + 12} ${oy + mm(25)} H${ox + mm(55) + 24}`} />
		<text class="t t-s" x={ox + mm(55) + 26} y={oy + mm(12.5)}>25</text>
	</svg>
</Figure>
