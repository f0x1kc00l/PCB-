---
/** Рис. 3.10: как устроена макетная плата — шины питания вдоль краёв, столбцы по 5 гнёзд, разрыв посередине. */
import Figure from '../Figure.astro';

const cols = 16;
const pitch = 34;
const x0 = 60;
const rowsTop = ['a', 'b', 'c', 'd', 'e'];
const rowsBot = ['f', 'g', 'h', 'i', 'j'];
const yTop = (i: number) => 70 + i * 16;
const yBot = (i: number) => 175 + i * 16;
const hl = 4; // подсвеченный столбец
---

<Figure n="3.10" caption="Внутри макетной платы гнёзда соединены группами: каждые пять гнёзд одного столбца (a–e или f–j) — одна цепь (подсвечено), по разные стороны центральной канавки — разные цепи. Длинные шины вдоль краёв — для питания (+) и земли (−). У некоторых плат шины разорваны посередине: проверь мультиметром.">
	<svg viewBox="0 0 640 300" role="img" aria-label="Макетная плата сверху: две пары шин питания по краям, посередине 16 столбцов по пять гнёзд сверху и снизу от канавки. Один столбец подсвечен как единая цепь.">
		<rect x="20" y="10" width="600" height="280" rx="8" fill="var(--sl-color-gray-6)" stroke="var(--sl-color-gray-4)" />
		<!-- шины -->
		<line x1="50" y1="24" x2="600" y2="24" stroke="#e05050" stroke-width="2" />
		<line x1="50" y1="44" x2="600" y2="44" stroke="#5080e0" stroke-width="2" />
		<line x1="50" y1="256" x2="600" y2="256" stroke="#e05050" stroke-width="2" />
		<line x1="50" y1="276" x2="600" y2="276" stroke="#5080e0" stroke-width="2" />
		<text class="t t-s" x="30" y="28" fill="#e05050">+</text>
		<text class="t t-s" x="30" y="48" fill="#5080e0">−</text>
		<text class="t t-s" x="30" y="260" fill="#e05050">+</text>
		<text class="t t-s" x="30" y="280" fill="#5080e0">−</text>
		{
			Array.from({ length: cols }, (_, c) => (
				<g>
					<circle cx={x0 + c * pitch} cy="34" r="0" />
					{[24, 44, 256, 276].map((yy) => (
						<rect x={x0 + c * pitch - 3} y={yy - 3} width="6" height="6" fill="var(--sl-color-gray-3)" />
					))}
				</g>
			))
		}
		<!-- центральная канавка -->
		<rect x="40" y="148" width="570" height="10" fill="var(--sl-color-gray-5)" />
		<!-- подсветка одного столбца -->
		<rect x={x0 + hl * pitch - 9} y={yTop(0) - 9} width="18" height="82" rx="4" fill="var(--sl-color-accent)" opacity="0.35" />
		<rect x={x0 + hl * pitch - 9} y={yBot(0) - 9} width="18" height="82" rx="4" fill="var(--pcb-altium)" opacity="0.3" />
		{
			Array.from({ length: cols }, (_, c) => (
				<g>
					{rowsTop.map((_, r) => (
						<rect x={x0 + c * pitch - 3} y={yTop(r) - 3} width="6" height="6" fill="var(--sl-color-gray-2)" />
					))}
					{rowsBot.map((_, r) => (
						<rect x={x0 + c * pitch - 3} y={yBot(r) - 3} width="6" height="6" fill="var(--sl-color-gray-2)" />
					))}
					<text class="t t-s t-mut" x={x0 + c * pitch} y="62" text-anchor="middle" font-size="9">
						{c + 1}
					</text>
				</g>
			))
		}
		{rowsTop.map((r, i) => <text class="t t-s t-mut" x="44" y={yTop(i) + 4} text-anchor="middle">{r}</text>)}
		{rowsBot.map((r, i) => <text class="t t-s t-mut" x="44" y={yBot(i) + 4} text-anchor="middle">{r}</text>)}
		<rect x={x0 + hl * pitch + 12} y="91" width="120" height="18" rx="3" fill="var(--sl-color-gray-6)" />
		<text class="t t-s t-acc" x={x0 + hl * pitch + 16} y="104">5a–5e: одна цепь</text>
		<rect x={x0 + hl * pitch + 12} y="197" width="130" height="18" rx="3" fill="var(--sl-color-gray-6)" />
		<text class="t t-s" x={x0 + hl * pitch + 16} y="210" fill="var(--pcb-altium)">5f–5j: другая цепь</text>
	</svg>
</Figure>
