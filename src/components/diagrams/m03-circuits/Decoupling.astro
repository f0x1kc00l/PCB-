---
/**
 * Рис. 3.5: развязка питания — схема (bulk + 100 нФ у каждого вывода) и вид платы сверху:
 * хорошее и плохое размещение конденсатора, площадь токовой петли.
 */
import Figure from '../Figure.astro';
import { capV, gnd, dot } from './sym';
---

<Figure n="3.5" caption="Слева — на схеме: один «большой» конденсатор на входе питания и по 100 нФ на каждый вывод питания микросхемы. Справа — вид на плату: конденсатор вплотную к выводам даёт маленькую петлю тока (зелёная), удалённый — большую петлю с заметной индуктивностью (красная).">
	<svg viewBox="0 0 660 250" role="img" aria-label="Схема: питание 3,3 вольта, конденсатор 10 мкФ у входа, микросхема с двумя выводами питания и по конденсатору 100 нФ у каждого. Справа: вид сверху на микросхему, конденсатор рядом с выводами с маленькой петлёй и конденсатор вдали с большой петлёй.">
		<!-- ===== Схема ===== -->
		<text class="t" x="10" y="18" font-weight="700">На схеме</text>
		<circle class="ln" cx="20" cy="50" r="4" />
		<text class="t t-s t-acc" x="10" y="38">+3,3 В</text>
		<path class="ln" d="M24 50 H250" />
		<g set:html={dot(60, 50)} />
		<g set:html={capV(60, 50, 160)} />
		<text class="t t-s" x="60" y="196" text-anchor="middle">10 мкФ</text>
		<text class="t t-s t-mut" x="60" y="210" text-anchor="middle">bulk</text>
		<g set:html={dot(150, 50)} />
		<g set:html={capV(150, 50, 160)} />
		<text class="t t-s" x="148" y="196" text-anchor="middle">100 нФ</text>
		<g set:html={dot(210, 50)} />
		<g set:html={capV(210, 50, 160)} />
		<text class="t t-s" x="212" y="196" text-anchor="middle">100 нФ</text>
		<path class="ln" d="M20 160 H250" />
		<g set:html={gnd(100, 160)} />
		<path class="ln" d="M250 50 V74 M250 58 H262 M250 74 H262" />
		<g set:html={dot(250, 58)} />
		<rect class="ln" x="262" y="40" width="40" height="110" rx="3" />
		<text class="t t-s" x="282" y="100" text-anchor="middle">DD1</text>
		<text class="t t-s t-mut" x="266" y="58">VDD</text>
		<text class="t t-s t-mut" x="266" y="74">VDD</text>
		<text class="t t-s t-mut" x="266" y="144">GND</text>
		<path class="ln" d="M250 160 H282 V150" />

		<!-- ===== Плата ===== -->
		<text class="t" x="350" y="18" font-weight="700">На плате (вид сверху)</text>
		<rect x="350" y="30" width="300" height="200" rx="6" fill="var(--pcb-mask)" opacity="0.85" />
		<!-- микросхема -->
		<rect x="470" y="80" width="70" height="90" rx="3" fill="#2a2a2a" />
		<rect x="458" y="92" width="12" height="8" fill="var(--pcb-copper)" />
		<rect x="458" y="150" width="12" height="8" fill="var(--pcb-copper)" />
		<text x="505" y="130" text-anchor="middle" font-size="11" fill="#ddd">МК</text>
		<text x="476" y="100" font-size="10" fill="#fff">VDD</text>
		<text x="476" y="158" font-size="10" fill="#fff">GND</text>
		<!-- хороший: конденсатор у выводов -->
		<rect x="432" y="108" width="14" height="28" rx="2" fill="#b8a07a" />
		<path d="M458 96 H439 V108 M439 136 V154 H458" stroke="var(--pcb-copper)" stroke-width="4" fill="none" />
		<rect x="438" y="98" width="20" height="52" fill="none" stroke="#4cff9a" stroke-width="2" stroke-dasharray="4 3" />
		<text x="414" y="126" text-anchor="end" font-size="10" fill="#4cff9a">малая петля</text>
		<!-- плохой: конденсатор далеко -->
		<rect x="590" y="190" width="28" height="14" rx="2" fill="#b8a07a" />
		<path d="M458 96 H450 V60 H630 V197 H618 M590 197 H562 V154 H540" stroke="var(--pcb-copper)" stroke-width="3" fill="none" opacity="0.8" />
		<path d="M454 64 H626 V193 M566 193 V158" stroke="#ff6a6a" stroke-width="2" stroke-dasharray="4 3" fill="none" />
		<text x="600" y="50" text-anchor="middle" font-size="10" fill="#ff8a8a">большая петля</text>
	</svg>
</Figure>
