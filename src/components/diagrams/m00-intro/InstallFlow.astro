---
/** Рис. к уроку 0.3: путь от регистрации до первого запуска Altium Designer. */
import Figure from '../Figure.astro';

const steps = [
	{ t: 'Аккаунт Altium', d: 'регистрация на altium.com' },
	{ t: 'Лицензия', d: 'студенческая или пробная' },
	{ t: 'Установщик', d: 'страница Downloads' },
	{ t: 'Установка', d: 'вход в аккаунт, выбор функций' },
	{ t: 'Первый запуск', d: 'проверка лицензии' },
];
const W = 170;
const H = 62;
const G = 34;
const pos = steps.map((s, i) => ({ ...s, x: 10 + (i % 3) * (W + G), y: i < 3 ? 20 : 130 }));
---

<Figure n="0.2" caption="Порядок действий. Лицензия привязана к аккаунту, поэтому установщик сначала просит войти, а уже потом скачивает программу.">
	<svg viewBox={`0 0 ${20 + 3 * W + 2 * G} 215`} role="img" aria-label="Пять шагов: аккаунт Altium, лицензия, установщик, установка, первый запуск.">
		<path class="ln-acc" d={`M${10 + W} 51 H${10 + W + G} M${10 + 2 * W + G} 51 H${10 + 2 * W + 2 * G}`} />
		<path class="ln-acc" d={`M${10 + 2.5 * W + 2 * G} 82 V106 H${10 + W / 2} V130`} />
		<path class="ln-acc" d={`M${10 + W} 161 H${10 + W + G}`} />
		{
			pos.map((p, i) => (
				<g>
					<rect x={p.x} y={p.y} width={W} height={H} rx="8" fill="var(--sl-color-gray-6)" stroke="var(--sl-color-hairline-light)" />
					<text class="t t-acc t-mono" x={p.x + 12} y={p.y + 25}>{i + 1}</text>
					<text class="t" x={p.x + 30} y={p.y + 25} font-weight="600">{p.t}</text>
					<text class="t t-s t-mut" x={p.x + 12} y={p.y + 47}>{p.d}</text>
				</g>
			))
		}
	</svg>
</Figure>
