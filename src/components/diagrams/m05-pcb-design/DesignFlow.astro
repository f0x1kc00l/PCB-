---
/** Рис. 5.1: последовательность проектирования платы — «змейка» из восьми этапов и петля исправлений после DRC. */
import Figure from '../Figure.astro';

const W = 140;
const H = 50;
const row1 = [
	{ x: 10, t: '1. Схема', s: 'источник истины' },
	{ x: 180, t: '2. Правила и стек', s: 'нормы завода' },
	{ x: 350, t: '3. Контур платы', s: 'механика, отверстия' },
	{ x: 520, t: '4. Размещение', s: '80 % успеха' },
];
const row2 = [
	{ x: 520, t: '5. Трассировка', s: 'критичное — первым' },
	{ x: 350, t: '6. Полигоны', s: 'земля, питание' },
	{ x: 180, t: '7. Проверка DRC', s: 'ноль нарушений' },
	{ x: 10, t: '8. Выпуск', s: 'Gerber, BOM, чертёж' },
];
---

<Figure n="5.1" caption="Порядок работы над платой. Этапы идут «змейкой»; после проверки DRC почти всегда приходится вернуться к трассировке или размещению. Изменения в соединениях вносятся в схему и переносятся на плату, а не наоборот.">
	<svg viewBox="0 0 680 240" role="img" aria-label="Восемь этапов: схема, правила и стек, контур платы, размещение, трассировка, полигоны, проверка DRC, выпуск. Пунктирная стрелка от DRC обратно к трассировке.">
		{
			[...row1.map((b) => ({ ...b, y: 20 })), ...row2.map((b) => ({ ...b, y: 130 }))].map((b, i) => (
				<g>
					<rect x={b.x} y={b.y} width={W} height={H} rx="8" class="ln" style={i === 3 ? 'stroke: var(--sl-color-accent)' : undefined} />
					<text class="t" x={b.x + W / 2} y={b.y + 22} text-anchor="middle" font-weight="700">{b.t}</text>
					<text class="t t-s t-mut" x={b.x + W / 2} y={b.y + 39} text-anchor="middle">{b.s}</text>
				</g>
			))
		}
		<!-- стрелки ряда 1 -->
		<path class="ln-acc" d="M150 45 H178 M171 39 L178 45 L171 51 M320 45 H348 M341 39 L348 45 L341 51 M490 45 H518 M511 39 L518 45 L511 51" />
		<!-- вниз к трассировке -->
		<path class="ln-acc" d="M590 70 V128 M584 121 L590 128 L596 121" />
		<!-- стрелки ряда 2 (справа налево) -->
		<path class="ln-acc" d="M520 155 H492 M499 149 L492 155 L499 161 M350 155 H322 M329 149 L322 155 L329 161 M180 155 H152 M159 149 L152 155 L159 161" />
		<!-- петля исправлений -->
		<path class="ln-dash" d="M250 180 V212 H590 V182 M584 189 L590 182 L596 189" />
		<text class="t t-s" x="420" y="228" text-anchor="middle">нарушения DRC → вернуться к трассировке или размещению</text>
	</svg>
</Figure>
