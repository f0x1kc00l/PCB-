---
/** Рис. 5.8: отвод тепла через термопереходы и цепочка тепловых сопротивлений. */
import Figure from '../Figure.astro';
const cu = 'var(--pcb-copper)';
const vias = [170, 195, 220, 245, 270];
---

<Figure n="5.8" caption="Слева: корпус с теплоотводящей площадкой (exposed pad) припаян к меди, термопереходы передают тепло на полигон нижнего слоя. Справа: тот же путь как цепочка тепловых сопротивлений. Перегрев кристалла ΔT = P·(θJC + θCB + θBA), так же как падение напряжения на последовательных резисторах.">
	<svg viewBox="0 0 660 240" role="img" aria-label="Разрез платы: микросхема на верхней меди, пять термопереходов идут к полигону на нижнем слое, стрелки тепла. Справа: последовательная цепочка тепловых сопротивлений от кристалла к воздуху.">
		<!-- плата -->
		<rect x="40" y="110" width="360" height="60" fill="var(--pcb-fr4)" opacity="0.55" />
		<rect x="40" y="102" width="360" height="8" fill={cu} />
		<rect x="40" y="170" width="360" height="8" fill={cu} />
		<!-- корпус -->
		<rect x="150" y="62" width="140" height="34" rx="4" fill="#2a2a2a" />
		<rect x="165" y="96" width="110" height="6" fill="#bbb" />
		<text class="t t-s" x="220" y="84" text-anchor="middle" fill="#eee">кристалл</text>
		<!-- термопереходы -->
		{vias.map((x) => <rect x={x - 4} y="102" width="8" height="76" fill={cu} />)}
		{vias.map((x) => <rect x={x - 1.5} y="104" width="3" height="72" fill="var(--sl-color-bg)" />)}
		<!-- стрелки тепла -->
		<path class="ln-acc" d="M120 190 V215 M114 208 L120 215 L126 208 M220 190 V215 M214 208 L220 215 L226 208 M320 190 V215 M314 208 L320 215 L326 208" />
		<text class="t t-s" x="220" y="235" text-anchor="middle">тепло уходит в полигон нижнего слоя и в воздух</text>
		<text class="t t-s t-mut" x="52" y="96">верхняя медь</text>
		<text class="t t-s t-mut" x="300" y="195">нижний полигон</text>
		<!-- цепочка θ -->
		<g class="t t-s">
			<text x="470" y="40" font-weight="700">TJ (кристалл)</text>
			<text x="470" y="105">TC (корпус)</text>
			<text x="470" y="170">TB (плата)</text>
			<text x="470" y="232">TA (воздух)</text>
		</g>
		<path class="ln" d="M450 34 V52 M450 84 V117 M450 149 V182 M450 214 V226" />
		<rect x="443" y="52" width="14" height="32" class="ln" />
		<rect x="443" y="117" width="14" height="32" class="ln" />
		<rect x="443" y="182" width="14" height="32" class="ln" />
		<text class="t t-acc" x="470" y="73">θJC</text>
		<text class="t t-acc" x="470" y="138">θCB</text>
		<text class="t t-acc" x="470" y="203">θBA</text>
	</svg>
</Figure>
