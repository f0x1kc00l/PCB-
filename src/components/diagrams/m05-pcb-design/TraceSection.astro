		<path class="ln-dash" d="M240 60 C235 50 250 42 240 30 M280 60 C275 50 290 42 280 30 M320 60 C315 50 330 42 320 30" />
		<path class="ln-dash" d="M210 120 C190 135 175 145 150 162 M350 120 C370 135 385 145 410 162" />
