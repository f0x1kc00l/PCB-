	<svg viewBox="0 0 560 220" role="img" aria-label="Разрез платы: на стеклотекстолите лежит медная дорожка шириной w и толщиной t, стрелки тепла идут вверх и в стороны.">
		<!-- FR-4 -->
		<rect x="40" y="120" width="480" height="70" fill="var(--pcb-fr4)" opacity="0.55" />
		<text class="t t-s" x="60" y="175">стеклотекстолит FR-4</text>
