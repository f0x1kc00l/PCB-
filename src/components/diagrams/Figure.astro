---
/**
 * Обёртка для иллюстраций в уроках: рамка + подпись «Рис. N».
 *   <Figure n="1.1" caption="Водопроводная аналогия"><svg …/></Figure>
 * SVG внутри рисуется цветом currentColor — линии сами подстраиваются под тему.
 */
interface Props {
	n?: string;
	caption: string;
}
const { n, caption } = Astro.props;
---

<figure class="diagram not-content">
	<div class="diagram__body"><slot /></div>
	<figcaption>
		{n && <strong>Рис. {n}. </strong>}
		{caption}
	</figcaption>
</figure>

<style>
	.diagram {
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--pcb-radius);
	}
	.diagram__body {
		color: var(--sl-color-white);
		overflow-x: auto;
	}
	.diagram__body :global(svg) {
		display: block;
		width: 100%;
		max-width: 680px;
		height: auto;
		margin-inline: auto;
	}
	/* Общие классы для текста и линий во всех схемах */
	.diagram__body :global(.t) {
		fill: currentColor;
		font-size: 13px;
		font-family: system-ui, sans-serif;
	}
	.diagram__body :global(.t-s) {
		font-size: 11px;
	}
	.diagram__body :global(.t-mono) {
		font-family: var(--pcb-mono);
	}
	.diagram__body :global(.t-acc) {
		fill: var(--sl-color-accent);
		font-weight: 700;
	}
	.diagram__body :global(.t-mut) {
		fill: var(--sl-color-gray-3);
	}
	.diagram__body :global(.ln) {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.diagram__body :global(.ln-acc) {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.diagram__body :global(.ln-thin) {
		fill: none;
		stroke: currentColor;
		stroke-width: 1;
		opacity: 0.5;
	}
	.diagram__body :global(.ln-dash) {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.2;
		stroke-dasharray: 5 4;
		opacity: 0.7;
	}
	.diagram__body :global(.fill-acc) {
		fill: var(--sl-color-accent);
	}
	.diagram__body :global(.fill-cur) {
		fill: currentColor;
	}
	figcaption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		text-align: center;
	}
</style>
