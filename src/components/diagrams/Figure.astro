---
/**
 * Обёртка для иллюстраций в уроках: рамка + подпись «Рис. N» + кнопка «открыть крупно».
 *   <Figure n="1.1" caption="Водопроводная аналогия"><svg …/></Figure>
 * SVG внутри рисуется цветом currentColor — линии сами подстраиваются под тему.
 * На телефоне схема ужимается по ширине экрана; кнопка ⤢ открывает её на весь экран
 * в увеличенном виде с прокруткой (и масштабированием пальцами).
 */
interface Props {
	n?: string;
	caption: string;
}
const { n, caption } = Astro.props;
---

<figure class="diagram not-content">
	<button type="button" class="diagram__zoom" aria-label="Открыть рисунок крупно" title="Открыть крупно">⤢</button>
	<div class="diagram__body"><slot /></div>
	<figcaption>
		{n && <strong>Рис. {n}. </strong>}
		{caption}
	</figcaption>
</figure>

<script>
	function openZoom(fig: HTMLElement) {
		const body = fig.querySelector('.diagram__body');
		const svg = body?.querySelector('svg');
		if (!body || !svg) return;
		const dlg = document.createElement('dialog');
		dlg.className = 'diagram-zoom';
		const vb = svg.viewBox?.baseVal;
		const w = vb && vb.width ? vb.width : svg.getBoundingClientRect().width;
		const inner = document.createElement('div');
		inner.className = 'diagram-zoom__inner diagram__body';
		const clone = svg.cloneNode(true) as SVGElement;
		clone.removeAttribute('style');
		clone.style.width = `max(100%, ${Math.round(w * 1.7)}px)`;
		clone.style.maxWidth = 'none';
		inner.appendChild(clone);
		const close = document.createElement('button');
		close.type = 'button';
		close.className = 'diagram-zoom__close';
		close.setAttribute('aria-label', 'Закрыть');
		close.textContent = '✕';
		const cap = fig.querySelector('figcaption')?.cloneNode(true);
		dlg.append(close, inner);
		if (cap) dlg.append(cap);
		document.body.appendChild(dlg);
		const done = () => {
			dlg.close();
			dlg.remove();
		};
		close.addEventListener('click', done);
		dlg.addEventListener('click', (e) => {
			if (e.target === dlg) done();
		});
		dlg.addEventListener('cancel', () => setTimeout(() => dlg.remove(), 0));
		dlg.showModal();
	}
	document.addEventListener('click', (e) => {
		const btn = (e.target as Element).closest?.('.diagram__zoom');
		if (btn) openZoom(btn.closest('figure') as HTMLElement);
	});
</script>

<style is:global>
	.diagram {
		position: relative;
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--pcb-radius);
		background: var(--pcb-figure-bg);
	}
	.diagram__zoom {
		position: absolute;
		top: 0.35rem;
		right: 0.35rem;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 0;
		border-radius: 0.4rem;
		background: transparent;
		color: var(--sl-color-gray-3);
		font-size: 1.25rem;
		cursor: zoom-in;
	}
	.diagram__zoom:hover,
	.diagram__zoom:focus-visible {
		color: var(--sl-color-accent);
		background: var(--sl-color-gray-6);
	}
	.diagram__body {
		color: var(--sl-color-white);
		overflow-x: auto;
	}
	.diagram__body svg {
		display: block;
		width: 100%;
		max-width: 680px;
		height: auto;
		margin-inline: auto;
	}
	/* Общие классы для текста и линий во всех схемах */
	.diagram__body .t {
		fill: currentColor;
		font-size: 13px;
		font-family: system-ui, sans-serif;
	}
	.diagram__body .t-s {
		font-size: 11px;
	}
	.diagram__body .t-mono {
		font-family: var(--pcb-mono);
	}
	.diagram__body .t-acc {
		fill: var(--sl-color-accent);
		font-weight: 700;
	}
	.diagram__body .t-mut {
		fill: var(--sl-color-gray-3);
	}
	.diagram__body .ln {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.diagram__body .ln-acc {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.diagram__body .ln-thin {
		fill: none;
		stroke: currentColor;
		stroke-width: 1;
		opacity: 0.5;
	}
	.diagram__body .ln-dash {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.2;
		stroke-dasharray: 5 4;
		opacity: 0.7;
	}
	.diagram__body .fill-acc {
		fill: var(--sl-color-accent);
	}
	.diagram__body .fill-cur {
		fill: currentColor;
	}
	.diagram figcaption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		text-align: center;
	}
	/* На узком экране — меньше полей, подпись по левому краю; мелкие детали открываются кнопкой ⤢ */
	@media (max-width: 40rem) {
		.diagram {
			padding: 0.75rem 0.5rem 0.6rem;
		}
		.diagram figcaption {
			text-align: start;
		}
	}
	dialog.diagram-zoom {
		width: 100vw;
		max-width: 100vw;
		height: 100dvh;
		max-height: 100dvh;
		margin: 0;
		padding: 3.25rem 0.75rem 1rem;
		border: 0;
		background: var(--sl-color-bg);
		color: var(--sl-color-white);
		overflow: auto;
	}
	dialog.diagram-zoom::backdrop {
		background: rgb(0 0 0 / 0.6);
	}
	.diagram-zoom__inner {
		overflow: auto;
		touch-action: pan-x pan-y pinch-zoom;
	}
	.diagram-zoom__inner svg {
		margin-inline: auto;
	}
	.diagram-zoom__close {
		position: fixed;
		top: 0.5rem;
		right: 0.5rem;
		width: 44px;
		height: 44px;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 50%;
		background: var(--sl-color-bg);
		color: var(--sl-color-white);
		font-size: 1.1rem;
		cursor: pointer;
	}
	dialog.diagram-zoom figcaption {
		max-width: 60rem;
		margin: 0.75rem auto 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
</style>
