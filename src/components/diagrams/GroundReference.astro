---
/** Рис. к уроку 1.1: «земля» как точка отсчёта, напряжения узлов и вольтметр между двумя точками. */
import Figure from './Figure.astro';
---

<Figure n="1.2" caption="Напряжения точек A и B отсчитываются от «земли» (0 В). Вольтметр всегда показывает разность между двумя точками: UAB = 9 − 4,5 = 4,5 В.">
	<svg viewBox="0 0 490 240" role="img" aria-label="Батарейка 9 В, два резистора по 1 кОм последовательно. Точка A — плюс 9 вольт, точка B между резисторами — плюс 4,5 вольта, минус батареи соединён с землёй. Вольтметр между A и B показывает 4,5 вольта.">
		<!-- батарейка -->
		<path class="ln" d="M60 40 V100 M60 116 V190" />
		<path class="ln" d="M42 100 H78" />
		<path d="M50 116 H70" stroke="currentColor" stroke-width="5" />
		<text class="t" x="36" y="96">+</text>
		<text class="t t-mono" x="86" y="113">9 В</text>
		<!-- верхний провод, R1, узел B, R2, нижний провод -->
		<path class="ln" d="M60 40 H300 V60 M300 100 V130 M300 170 V190 H60" />
		<rect class="ln" x="293" y="60" width="14" height="40" />
		<rect class="ln" x="293" y="130" width="14" height="40" />
		<text class="t" x="285" y="78" text-anchor="end">R1</text>
		<text class="t t-s t-mut" x="285" y="93" text-anchor="end">1 кОм</text>
		<text class="t" x="285" y="148" text-anchor="end">R2</text>
		<text class="t t-s t-mut" x="285" y="163" text-anchor="end">1 кОм</text>
		<!-- узлы -->
		<circle cx="300" cy="40" r="4" class="fill-acc" />
		<circle cx="300" cy="115" r="4" class="fill-acc" />
		<path class="ln" d="M300 115 H330" />
		<text class="t t-acc" x="312" y="34">A: +9 В</text>
		<text class="t t-acc" x="312" y="134">B: +4,5 В</text>
		<!-- земля -->
		<path class="ln" d="M180 190 V205 M166 205 H194 M171 211 H189 M176 217 H184" />
		<text class="t t-acc" x="200" y="214">GND = 0 В</text>
		<!-- вольтметр между A и B -->
		<path class="ln" d="M300 40 H400 V58 M400 96 V115 H330" />
		<circle class="ln" cx="400" cy="77" r="19" />
		<text class="t" x="400" y="82" text-anchor="middle" font-weight="700">V</text>
		<text class="t t-mono" x="425" y="81">4,5 В</text>
	</svg>
</Figure>
