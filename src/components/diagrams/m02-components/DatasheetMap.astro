---
/** Рис. 2.11 (урок 2.11): из каких разделов состоит типичный даташит и что в каждом искать. */
import Figure from '../Figure.astro';

const blocks = [
	{ t: 'Первая страница', d: 'что это, ключевые особенности, корпуса, цоколёвка', for: 'выбор детали' },
	{ t: 'Absolute Maximum Ratings', d: 'предельные значения: превысил — деталь может умереть', for: 'никогда не подходить вплотную' },
	{ t: 'Thermal Characteristics', d: 'тепловое сопротивление, мощность', for: 'расчёт нагрева' },
	{ t: 'Electrical Characteristics', d: 'min / typ / max при указанных условиях', for: 'расчёт схемы' },
	{ t: 'Typical Characteristics', d: 'графики: зависимость параметров от тока, температуры', for: 'понимание поведения' },
	{ t: 'Package Dimensions', d: 'чертёж корпуса, рекомендуемая площадка', for: 'посадочное место на плате' },
];
---

<Figure n="2.11" caption="Карта типичного даташита на дискретный компонент. Названия разделов у разных производителей немного отличаются, но порядок почти всегда такой. Справа — для какой задачи раздел нужен конструктору платы.">
	<svg viewBox="0 0 640 330" role="img" aria-label="Шесть блоков сверху вниз: первая страница, абсолютные максимальные значения, тепловые характеристики, электрические характеристики, типовые графики, размеры корпуса — с пояснениями.">
		{
			blocks.map((b, i) => (
				<g>
					<rect x="20" y={14 + i * 52} width="250" height="42" rx="6" fill={i === 1 ? 'var(--pcb-warn-bg)' : 'var(--sl-color-gray-6)'} stroke={i === 1 ? 'var(--pcb-warn)' : 'var(--sl-color-gray-5)'} />
					<text class="t" x="34" y={33 + i * 52} font-weight="700">{b.t}</text>
					<text class="t t-s t-mut" x="34" y={48 + i * 52}>{b.d}</text>
					<path class="ln-thin" d={`M276 ${35 + i * 52} H330`} />
					<text class="t t-acc t-s" x="340" y={39 + i * 52}>{b.for}</text>
				</g>
			))
		}
	</svg>
</Figure>
