---
/**
 * Рис. 2.10 (урок 2.10): распространённые корпуса в одном масштабе (вид сверху, без выводов там, где они под корпусом).
 * Масштаб: 12 px = 1 мм. Размеры — номинальные размеры тела по JEDEC; точные — в даташите конкретной детали.
 */
import Figure from '../Figure.astro';

const S = 12;
type Pkg = { name: string; bw: number; bh: number; pins: number; side: 'two' | 'four' | 'three' | 'none'; pitch: string; note: string; tht?: boolean };
const pkgs: Pkg[] = [
	{ name: 'DIP-8', bw: 9.8, bh: 6.4, pins: 4, side: 'two', pitch: '2,54', note: 'THT', tht: true },
	{ name: 'SOIC-8', bw: 4.9, bh: 3.9, pins: 4, side: 'two', pitch: '1,27', note: 'SMD' },
	{ name: 'TSSOP-8', bw: 3.0, bh: 4.4, pins: 4, side: 'two', pitch: '0,65', note: 'SMD' },
	{ name: 'SOT-23', bw: 2.9, bh: 1.3, pins: 3, side: 'three', pitch: '0,95', note: 'SMD' },
	{ name: 'SOT-223', bw: 6.5, bh: 3.5, pins: 3, side: 'three', pitch: '2,3', note: 'SMD' },
	{ name: 'QFN-16', bw: 3.0, bh: 3.0, pins: 4, side: 'four', pitch: '0,5', note: 'SMD, под корпусом' },
];
let cx = 20;
const placed = pkgs.map((p) => {
	const w = p.bw * S;
	const item = { ...p, x: cx, w, h: p.bh * S };
	cx += Math.max(w, 70) + 34;
	return item;
});
const base = 150;
---

<Figure n="2.10" caption="Корпуса в одном масштабе (сверху — полоска 5 мм). Шаг выводов — расстояние между центрами соседних выводов, в миллиметрах. Чем меньше шаг, тем сложнее паять вручную. Размеры номинальные (JEDEC); точные — в даташите детали.">
	<svg viewBox={`0 0 ${cx + 20} 250`} role="img" aria-label="Шесть корпусов в масштабе: DIP-8, SOIC-8, TSSOP-8, SOT-23, SOT-223 и QFN-16 с шагом выводов.">
		<path class="ln" d={`M20 18 H${20 + 5 * S} M20 13 V23 M${20 + 5 * S} 13 V23`} />
		<text class="t t-s" x={20 + 5 * S + 8} y="22">5 мм</text>
		{
			placed.map((p) => {
				const y = base - p.h;
				const pins: { x: number; y: number; w: number; h: number }[] = [];
				if (p.side === 'two') {
					for (let i = 0; i < p.pins; i++) {
						const px = p.x + ((i + 0.5) * p.w) / p.pins - 3;
						pins.push({ x: px, y: y - 10, w: 6, h: 10 }, { x: px, y: base, w: 6, h: 10 });
					}
				} else if (p.side === 'three') {
					pins.push({ x: p.x + p.w / 2 - 4, y: y - 10, w: p.name === 'SOT-223' ? 24 : 8, h: 10 });
					pins.push({ x: p.x + 4, y: base, w: 8, h: 10 }, { x: p.x + p.w - 12, y: base, w: 8, h: 10 });
					if (p.name === 'SOT-223') pins.push({ x: p.x + p.w / 2 - 4, y: base, w: 8, h: 10 });
				}
				return (
					<g>
						{pins.map((q) => (
							<rect x={q.x} y={q.y} width={q.w} height={q.h} fill={p.tht ? '#b8b8b8' : '#c8c8c8'} />
						))}
						<rect x={p.x} y={y} width={p.w} height={p.h} rx="2" fill="#2a2a2a" />
						{p.side === 'four' && (
							<rect x={p.x + 3} y={y + 3} width={p.w - 6} height={p.h - 6} fill="none" stroke="#777" stroke-dasharray="2 2" />
						)}
						<circle cx={p.x + 6} cy={y + 6} r="2.5" fill="#888" />
						<text class="t t-acc" x={p.x + Math.max(p.w, 70) / 2} y={base + 34} text-anchor="middle">{p.name}</text>
						<text class="t t-s" x={p.x + Math.max(p.w, 70) / 2} y={base + 52} text-anchor="middle">шаг {p.pitch} мм</text>
						<text class="t t-s t-mut" x={p.x + Math.max(p.w, 70) / 2} y={base + 68} text-anchor="middle">{p.note}</text>
					</g>
				);
			})
		}
	</svg>
</Figure>
