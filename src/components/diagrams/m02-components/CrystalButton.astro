		<text class="t" x="182" y="104" text-anchor="end">ZQ1</text>
		<text class="t t-s t-mut" x="182" y="120" text-anchor="end">8 МГц</text>
		<!-- C1, C2 -->
		<circle cx="160" cy="70" r="3" class="fill-cur" />
		<circle cx="160" cy="150" r="3" class="fill-cur" />
		<path class="ln" d="M160 70 V36 H260 V48 M160 150 V170 H260 V160" />
		<path d="M248 48 H272 M248 56 H272" stroke="currentColor" stroke-width="2.5" />
		<path d="M248 160 H272 M248 152 H272" stroke="currentColor" stroke-width="2.5" />
		<path class="ln" d="M260 56 V100 M260 152 V112 M260 100 V112" />
		<text class="t t-s" x="278" y="56">C1 22 пФ</text>
		<text class="t t-s" x="278" y="164">C2 22 пФ</text>
		<path class="ln" d="M246 106 H274 M251 112 H269 M256 118 H264" />

		<!-- ===== Кнопка ===== -->
		<text class="t t-acc" x="480" y="24" text-anchor="middle">+3,3 В</text>
		<path class="ln" d="M480 32 V50 M480 100 V130 H555" />
		<rect class="ln" x="472" y="50" width="16" height="50" />
		<text class="t t-s" x="496" y="80">R1 10 кОм</text>
		<circle cx="480" cy="130" r="3" class="fill-cur" />
		<text class="t t-s" x="560" y="134">вход МК</text>
		<path class="ln" d="M480 130 V156 M480 196 V214" />
		<path class="ln" d="M480 196 L462 164" />
		<path class="ln" d="M458 172 H448 V186 H458" />
		<circle cx="480" cy="156" r="3" class="fill-cur" />
		<circle cx="480" cy="196" r="3" class="fill-cur" />
