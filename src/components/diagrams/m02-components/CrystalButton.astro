---
/** Рис. 2.9 (урок 2.9): кварц с конденсаторами нагрузки у микроконтроллера; кнопка с подтяжкой к питанию. */
import Figure from '../Figure.astro';
---

<Figure n="2.9" caption="Слева: кварцевый резонатор между выводами генератора микроконтроллера и два конденсатора на землю. Их ёмкость подбирают по ёмкости нагрузки CL из даташита кварца. Справа: кнопка замыкает вход на землю, резистор 10 кОм подтягивает вход к питанию, пока кнопка отпущена.">
	<svg viewBox="0 0 640 250" role="img" aria-label="Слева микроконтроллер с выводами XTAL1 и XTAL2, между ними кварц ZQ1, от каждого вывода конденсатор 22 пикофарады на землю. Справа: питание 3,3 вольта, резистор 10 килоом к входу микроконтроллера, кнопка от входа на землю.">
		<!-- МК -->
		<rect class="ln" x="20" y="40" width="90" height="140" />
		<text class="t" x="65" y="114" text-anchor="middle" font-weight="700">МК</text>
		<text class="t t-s t-mono" x="104" y="74" text-anchor="end">XTAL1</text>
		<text class="t t-s t-mono" x="104" y="154" text-anchor="end">XTAL2</text>
		<path class="ln" d="M110 70 H200 V96 M110 150 H200 V124" />
