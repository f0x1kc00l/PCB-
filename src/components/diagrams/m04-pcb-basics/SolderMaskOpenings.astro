---
/**
 * Рис. 4.6 (урок 4.5): окна в паяльной маске, вид сверху.
 * Две площадки корпуса SOIC-подобной микросхемы: расширение маски и перемычка между окнами.
 */
import Figure from '../Figure.astro';

const CU = 'var(--pcb-copper)';
const MASK = 'var(--pcb-mask)';
---

<Figure n="4.6" caption="Окно в маске делают чуть больше площадки (расширение, expansion), чтобы маска не наползла на медь при неточном совмещении. Между соседними окнами остаётся полоска маски — перемычка (dam): она не даёт припою перетечь между выводами. Если площадки стоят слишком тесно, перемычка получается тоньше минимума производителя, и окна объединяют одним общим.">
	<svg viewBox="0 0 600 230" role="img" aria-label="Вид сверху: зелёная маска, два прямоугольных окна чуть больше медных площадок, между окнами узкая полоска маски — перемычка. Отдельно показана дорожка под маской.">
		<rect x="20" y="20" width="560" height="190" rx="8" fill={MASK} />
		<!-- дорожка под маской (медь видна сквозь маску чуть светлее) -->
		<rect x="60" y="150" width="200" height="10" fill={CU} opacity="0.45" />
		<text x="60" y="185" font-size="12" fill="#ffffff" font-family="system-ui, sans-serif">дорожка под маской</text>
		<!-- окна маски и площадки -->
		<rect x="300" y="50" width="60" height="120" fill="var(--sl-color-gray-6)" />
		<rect x="304" y="54" width="52" height="112" fill={CU} />
		<rect x="380" y="50" width="60" height="120" fill="var(--sl-color-gray-6)" />
		<rect x="384" y="54" width="52" height="112" fill={CU} />
		<!-- подписи -->
		<g font-size="12" fill="#ffffff" font-family="system-ui, sans-serif">
			<path d="M330 50 V36" stroke="#fff" stroke-width="1" />
			<text x="250" y="32">окно маски = площадка + расширение</text>
			<path d="M370 176 V196" stroke="#fff" stroke-width="1" />
			<text x="370" y="206" text-anchor="middle">перемычка маски (dam)</text>
			<path d="M410 110 H470" stroke="#fff" stroke-width="1" />
			<text x="474" y="108">площадка</text>
			<text x="474" y="122">(открытая медь)</text>
		</g>
	</svg>
</Figure>
