---
/**
 * Рис. 4.8 (урок 4.7): типовой термопрофиль оплавления для бессвинцовой пасты SAC305.
 * Значения ориентировочные; рабочий профиль берут из даташита пасты и проверяют по
 * допустимым температурам компонентов (J-STD-020).
 * Масштаб: x = 60 + t·1,4 (t в секундах), y = 250 − (T − 25)·0,85.
 */
import Figure from '../Figure.astro';

const x = (t: number) => 60 + t * 1.4;
const y = (T: number) => 250 - (T - 25) * 0.85;
// опорные точки профиля (с, °C)
const pts = [
	[0, 25],
	[90, 150],
	[180, 190],
	[215, 217],
	[240, 245],
	[265, 217],
	[330, 100],
	[360, 70],
];
const d = pts.map(([t, T], i) => `${i ? 'L' : 'M'}${x(t).toFixed(1)} ${y(T).toFixed(1)}`).join(' ');
const ticksT = [60, 120, 180, 240, 300, 360];
const ticksC = [50, 100, 150, 200, 250];
const zones = [
	{ a: 0, b: 90, label: 'нагрев' },
	{ a: 90, b: 180, label: 'выдержка' },
	{ a: 180, b: 265, label: 'оплавление' },
	{ a: 265, b: 360, label: 'охлаждение' },
];
---

<Figure n="4.8" caption="Ориентировочный профиль оплавления бессвинцовой пасты SAC305. Сначала плату плавно нагревают, потом выдерживают около 150–190 °C, чтобы всё прогрелось равномерно и активировался флюс. Затем коротко поднимают температуру выше точки плавления (~217 °C) до пика 235–250 °C и охлаждают. Точный профиль задаёт даташит пасты, а предел для компонентов — их паспорт (обычно не выше 260 °C).">
	<svg viewBox="0 0 600 300" role="img" aria-label="График температуры от времени: подъём до 150, плато до 190, пик около 245 градусов, участок выше 217 градусов около минуты, затем охлаждение.">
		<!-- зоны -->
		{zones.map((z, i) => (
			<g>
				<rect x={x(z.a)} y={y(260)} width={x(z.b) - x(z.a)} height={y(25) - y(260)} fill={i % 2 ? 'var(--sl-color-gray-6)' : 'transparent'} />
				<text class="t t-s t-mut" x={(x(z.a) + x(z.b)) / 2} y={y(35)} text-anchor="middle">{z.label}</text>
			</g>
		))}
		<!-- сетка и оси -->
		{ticksC.map((c) => <line class="ln-thin" x1={x(0)} y1={y(c)} x2={x(360)} y2={y(c)} />)}
		<path class="ln" d={`M${x(0)} ${y(25)} H${x(370)} M${x(0)} ${y(25)} V${y(268)}`} />
		{ticksT.map((t) => <text class="t t-s t-mut" x={x(t)} y={y(25) + 16} text-anchor="middle">{t}</text>)}
		{ticksC.map((c) => <text class="t t-s t-mut" x={x(0) - 8} y={y(c) + 4} text-anchor="end">{c}</text>)}
		<text class="t t-s" x={x(370)} y={y(25) + 32} text-anchor="end">время, с</text>
		<text class="t t-s" x={x(0) + 6} y={y(268) + 4}>T, °C</text>
		<!-- ликвидус -->
		<path class="ln-dash" d={`M${x(0)} ${y(217)} H${x(360)}`} />
		<text class="t t-s" x={x(6)} y={y(217) - 6}>217 °C — плавление SAC305</text>
		<!-- время выше ликвидуса -->
		<path class="ln-acc" d={`M${x(215)} ${y(205)} H${x(265)} M${x(215)} ${y(200)} V${y(210)} M${x(265)} ${y(200)} V${y(210)}`} />
		<text class="t t-s t-acc" x={x(240)} y={y(195)} text-anchor="middle">45–90 с</text>
		<!-- профиль -->
		<path d={d} fill="none" stroke="var(--sl-color-accent)" stroke-width="3" />
		<circle cx={x(240)} cy={y(245)} r="4" class="fill-acc" />
		<text class="t t-s t-acc" x={x(246)} y={y(245) - 6}>пик 235–250 °C</text>
	</svg>
</Figure>
