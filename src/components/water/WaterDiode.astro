---
/**
 * Диод = обратный клапан с пружиной: чтобы открыть заслонку, нужно ~0,6 В давления.
 * Стабилитрон = ещё и предохранительный клапан: в обратную сторону открывается при Uст.
 * Ток — по уравнению Шокли (Хоровиц §1.25, рис. 1.13 и 1.67).
 */
import WaterFrame from './WaterFrame.astro';
interface Props {
	n?: string;
	zener?: boolean;
}
const { n, zener = false } = Astro.props;
---

<WaterFrame
	tag="water-diode"
	n={n}
	title="Диод: обратный клапан с пружиной"
	map={[
		['заслонка', 'p-n-переход'],
		['пружина', 'прямое падение ≈ 0,6 В'],
		['клапан сброса в обратную сторону', 'пробой стабилитрона'],
	]}
	caption="В прямую сторону заслонка открывается, только когда давление пересилит пружину — до ~0,5 В тока почти нет, после 0,7 В он растёт лавиной. В обратную сторону заслонка прижата к седлу: течёт лишь крошечная утечка. У стабилитрона рядом стоит предохранительный клапан: он открывается при обратном давлении Uст и держит его почти постоянным."
>
	<div class="water__stage">
	<svg viewBox="8 40 372 190" style="--w:372" role="img" aria-label="Горизонтальная труба с заслонкой на пружине; справа график ВАХ диода с точкой текущего режима.">
		<g stroke-width="14">
			<line data-p="l" class="pipe" x1="20" y1="110" x2="170" y2="110" />
			<line data-p="r" class="pipe" x1="210" y1="110" x2="360" y2="110" />
		</g>
		<!-- корпус клапана -->
		<rect x="160" y="80" width="60" height="60" rx="6" class="wall" />
		<line x1="190" y1="88" x2="190" y2="102" class="ln" stroke-width="3" />
		<line x1="190" y1="118" x2="190" y2="132" class="ln" stroke-width="3" />
		<g data-flap><rect x="186" y="92" width="6" height="36" rx="2" fill="var(--sl-color-accent)" /></g>
		<path data-spring d="" class="ln" stroke-width="1.2" />
		<!-- стабилитрон: обходной предохранительный клапан -->
		<g data-zg>
			<polyline class="pipe" data-p="z" stroke-width="7" points="130,110 130,185 250,185 250,110" />
			<rect x="175" y="172" width="30" height="26" rx="4" class="wall" />
			<rect data-zf x="189" y="174" width="4" height="22" fill="var(--sl-color-accent)" />
			<text class="ts" x="190" y="214" text-anchor="middle">клапан сброса (Uст)</text>
		</g>
		<text class="ts" x="20" y="90">анод (A)</text>
		<text class="ts" x="360" y="90" text-anchor="end">катод (K)</text>
		<text class="t tm" data-dir x="190" y="60" text-anchor="middle"></text>
		<g data-d></g>
		<!-- ВАХ -->
		
		</svg>
	<svg viewBox="404 12 262 244" style="--w:262" aria-hidden="true">
		<g transform="translate(410 20)">
			<rect width="250" height="230" class="grid" />
			<path data-ax d="" class="grid" />
			<polyline data-iv class="tr-i" />
			<circle data-pt r="5" fill="var(--water-hi)" />
			<text class="ts" x="246" y="12" text-anchor="end">I</text>
			<text class="ts" x="246" y="226" text-anchor="end">U →</text>
		</g>
	</svg>
	</div>
	<div class="water__controls">
		<label class="water__row"><span>Давление A − K (напряжение U)</span><input type="range" data-u min={zener ? -7 : -5} max="0.85" step="0.01" value="0.3" /><output data-uv></output></label>
	</div>
	<div class="water__btns">
		<label class="water__check"><input type="checkbox" data-z checked={zener} /> это стабилитрон, Uст = 5,1 В</label>
	</div>
	<p class="water__readout" data-fx></p>
	<p class="water__note" data-fx2></p>
</WaterFrame>

<script>
	import { Path, Drops, animate, paint, fm, si, $ } from '../../lib/water';

	const IS = 2e-9,
		NVT = 1.8 * 0.02585,
		VZ = 5.1,
		RZ = 2;
	function idiode(u: number, z: boolean) {
		let i = IS * (Math.exp(Math.min(u, 0.9) / NVT) - 1);
		if (z && u < -VZ + 0.3) i -= Math.exp((-u - VZ) / 0.05) * 1e-3 + Math.max(0, -u - VZ) / RZ;
		return i;
	}
	class WaterDiode extends HTMLElement {
		connectedCallback() {
			const r = this;
			let U = 0.3,
				Z = (r.querySelector('[data-z]') as HTMLInputElement).checked,
				I = 0;
			const g = $(r, '[data-d]');
			const fwd = new Drops(g, new Path([[20, 110], [360, 110]]), 16);
			const zp = new Drops(g, new Path([[250, 110], [250, 185], [130, 185], [130, 110]]), 14);
			const ox = 410,
				oy = 20,
				W = 250,
				H = 230;
			// масштаб графика: прямая ветвь растянута (0..0,85 В на правую треть), обратная сжата
			const umin = () => (Z ? -7 : -5);
			const x0 = W * 0.62;
			const mapU = (u: number) => (u >= 0 ? x0 + (u / 0.85) * (W - x0 - 6) : x0 * (1 - u / umin()));
			const IMAX = 0.1;
			const mapI = (i: number) => H * 0.62 - (Math.max(-IMAX * 0.6, Math.min(IMAX, i)) / IMAX) * (H * 0.6);
			const curve = () => {
				const pts: string[] = [];
				for (let k = 0; k <= 200; k++) {
					const u = umin() + ((0.85 - umin()) * k) / 200;
					pts.push(`${mapU(u).toFixed(1)},${mapI(idiode(u, Z)).toFixed(1)}`);
				}
				$(r, '[data-iv]').setAttribute('points', pts.join(' '));
				$(r, '[data-ax]').setAttribute('d', `M${x0} 0V${H}M0 ${(H * 0.62).toFixed(0)}H${W}`);
			};
			const upd = () => {
				I = idiode(U, Z);
				$(r, '[data-uv]').textContent = fm(U, 2) + ' В';
				($(r, '[data-zg]') as SVGGElement).style.display = Z ? '' : 'none';
				zp.hide(!Z);
				const open = Math.max(0, Math.min(1, Math.log10(Math.max(I, 1e-9) / 1e-6) / 5));
				$(r, '[data-flap]').setAttribute('transform', `rotate(${(-75 * open).toFixed(1)} 189 92)`);
				const zOpen = Z && U < -VZ + 0.1 ? Math.min(1, (-U - VZ + 0.1) / 0.6) : 0;
				$(r, '[data-zf]').setAttribute('transform', `translate(0 ${(-18 * zOpen).toFixed(1)})`);
				const sx = 192 + 22 * (1 - open);
				$(r, '[data-spring]').setAttribute('d', `M${sx.toFixed(1)} 100 l3 -4 l3 8 l3 -8 l3 8 l3 -4 L218 100`);
				paint([$(r, '[data-p="l"]')], U >= 0 ? 0.25 + U / 1.2 : 0.15);
				paint([$(r, '[data-p="r"]')], U >= 0 ? 0.15 : Math.min(1, -U / 6));
				paint([$(r, '[data-p="z"]')], 0.4);
				$(r, '[data-pt]').setAttribute('cx', mapU(U).toFixed(1));
				$(r, '[data-pt]').setAttribute('cy', mapI(I).toFixed(1));
				$(r, '[data-dir]').textContent = U >= 0 ? 'давление → прямое' : '← давление обратное';
				$(r, '[data-fx]').textContent = `U = ${fm(U, 2)} В → I = ${si(I, 'А')}`;
				$(r, '[data-fx2]').textContent =
					U < 0.4 && U >= 0
						? 'Пружина держит заслонку: тока практически нет.'
						: U >= 0.4
							? 'Каждые +0,1 В — ток примерно ×7–10 (экспонента Шокли). Поэтому «0,6–0,7 В» почти не зависит от тока, а светодиоду нужен резистор.'
							: Z && U <= -VZ + 0.1
								? 'Обратное давление достигло Uст — открылся клапан сброса. Дальше напряжение почти не растёт, растёт ток: так стабилитрон держит опорное напряжение.'
								: 'Обратное направление: заслонка прижата, только утечка — наноамперы.';
			};
			curve();
			upd();
			r.addEventListener('input', (e) => {
				const t = e.target as HTMLInputElement;
				if (t.matches('[data-u]')) U = +t.value;
				if (t.matches('[data-z]')) {
					Z = t.checked;
					const s = r.querySelector('[data-u]') as HTMLInputElement;
					s.min = Z ? '-7' : '-5';
					U = Math.max(U, +s.min);
					curve();
				}
				upd();
			});
			animate(r, (dt) => {
				const v = Math.sign(I) * Math.min(120, 40 * Math.sqrt(Math.abs(I) / 0.01));
				if (I > 0) fwd.step(v * dt);
				else if (Z && I < -1e-4) zp.step(-v * dt);
			});
		}
	}
	customElements.define('water-diode', WaterDiode);
</script>
