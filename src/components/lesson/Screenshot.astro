---
/**
 * Скриншот Altium или плейсхолдер на его месте.
 *
 *   <Screenshot src="screenshots/m07/l02-components-panel.png" alt="панель Components, поиск BC547" />
 *
 * Если файла public/<src> ещё нет, на странице видна рамка
 * «[СКРИНШОТ: …]» с путём, куда положить картинку. Положил файл —
 * пересобрал сайт — на месте рамки появилась картинка. Код урока менять не нужно.
 */
import fs from 'node:fs';
import path from 'node:path';
import { withBase } from '../../lib/site';

interface Props {
	/** Путь внутри папки public/, без ведущего слэша. */
	src: string;
	/** Что на скриншоте (это же — текст плейсхолдера и alt картинки). */
	alt: string;
	/** Подпись под картинкой. */
	caption?: string;
}

const { src, alt, caption } = Astro.props;
const exists = fs.existsSync(path.join(process.cwd(), 'public', src));
---

<figure class="screenshot not-content">
	{
		exists ? (
			<img src={withBase(src)} alt={alt} loading="lazy" decoding="async" />
		) : (
			<div class="placeholder" role="img" aria-label={`Скриншот будет добавлен: ${alt}`}>
				<strong>[СКРИНШОТ: {alt}]</strong>
				<code>public/{src}</code>
			</div>
		)
	}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.screenshot {
		margin-block: 1.25rem;
	}
	img {
		max-width: 100%;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--pcb-radius);
	}
	.placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-height: 9rem;
		padding: 1rem;
		border: 2px dashed var(--sl-color-gray-4);
		border-radius: var(--pcb-radius);
		background: repeating-linear-gradient(
			-45deg,
			transparent 0 10px,
			var(--sl-color-gray-6) 10px 20px
		);
		text-align: center;
		color: var(--sl-color-gray-2);
	}
	.placeholder code {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	figcaption {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
